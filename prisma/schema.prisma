generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  // Workspace avatar shown in the org switcher — a small data URL (client
  // resizes to 128px before upload) so no external storage is required.
  logoUrl               String?
  plan                  Plan      @default(TRIAL)
  /// Platform tier. 'internal' = Backstory; 'partner' = People.ai; 'customer'
  /// = every paying workspace; 'demo' = a user's disposable anonymised copy
  /// of their workspace (Demo mode). Only a platform reviewer may change this
  /// — it is never settable from a customer-facing route.
  kind                  String    @default("customer")
  /// 'demo' orgs only: the real workspace this is an anonymised copy of.
  /// Scalar on purpose (no FK relation): teardown order is enforced in
  /// org-teardown, and a cascade here would delete the sandbox mid-request
  /// instead of through the teardown path.
  demoOfOrganizationId  String?   @db.Uuid
  /// 'demo' orgs only: the single user who may enter this sandbox. Unique —
  /// one demo workspace per person, reused across sessions until exited.
  demoOwnerUserId       String?   @unique
  // People.ai tenant binding: one Studio workspace per People.ai team. Set on
  // first People.ai connection; every rep from that team lands in this org.
  peopleAiTeamId        String?   @unique
  /// HMAC signing secret for this org's People.ai webhook deliveries.
  /// Stored encrypted (src/lib/crypto/secrets.ts encryptSecret) — verification
  /// needs the plaintext, so this is NOT a hash. Null = org falls back to the
  /// global PEOPLE_AI_WEBHOOK_SECRET during migration.
  peopleAiWebhookSecret String?
  // Entitlement snapshot, derived from an active People.ai Sales AI
  // connection and revalidated on a TTL (see src/lib/entitlement.ts).
  /// 'allowed' (default) | 'blocked'. Blocked refuses every model call for
  /// this workspace — the switch for customers whose DPA forbids AI
  /// processing. Enforced in assertAiCallAllowed, recorded either way.
  aiEgressPolicy        String    @default("allowed")
  entitlementTier       String?
  entitlementStatus     String    @default("unknown")
  entitlementCheckedAt  DateTime? @db.Timestamptz(6)
  trialStartDate        DateTime  @default(now()) @db.Timestamptz(6)
  trialEndDate          DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  /// Transactionally maintained quota counter for StoredFile bytes.
  storageBytes          BigInt    @default(0)
  /// Enterprise access policy. `optional` allows AAL1; `required` requires a
  /// verified second factor (AAL2) for every interactive session.
  mfaPolicy             String    @default("optional")
  /// When true, members whose email belongs to a verified workspace domain
  /// must authenticate through an enterprise SSO provider.
  ssoEnforced           Boolean   @default(false)
  /// When true, a flow cannot be published until someone other than its author
  /// approves the change. Our approvals are RUNTIME gates — a running agent
  /// pauses before a write — and nothing reviewed a flow DEFINITION before it
  /// went live on a schedule against real customer systems. Off by default:
  /// a two-person workspace does not want a second pair of eyes it does not
  /// have.
  flowReviewRequired    Boolean   @default(false)

  users                 User[]
  flowReviews           FlowReview[]
  agents                AgentTask[]
  executions            AgentExecution[]
  templates             AgentTemplate[]
  flowTemplates         FlowTemplate[]
  integrations          Integration[]
  notifications         Notification[]
  mcpConnections        McpConnection[]
  nangoConnections      NangoConnection[]
  integrationSecrets    IntegrationSecret[]
  httpCredentials       HttpCredential[]
  peopleAiConnections   PeopleAiConnection[]
  signals               Signal[]
  signalSubscriptions   SignalSubscription[]
  auditEvents           AuditEvent[]
  approvalRequests      ApprovalRequest[]
  agentMemories         AgentMemory[]
  flowVersions          FlowVersion[]
  flowEditSnapshots     FlowEditSnapshot[]
  flowTemplateVersions  FlowTemplateVersion[]
  flows                 Flow[]
  storedFiles           StoredFile[]
  customSignals         CustomSignal[]
  pushSubscriptions     PushSubscription[]
  knowledgeDocuments    KnowledgeDocument[]
  sharedSkills          SharedSkill[]
  templateProposals     TemplateProposal[]
  invitations           Invitation[]
  catalogueSubmissions  CatalogueSubmission[]
  huddleSegments        HuddleSegment[]
  huddleNotes           HuddleNote[]
  flowWebhookReceipts   FlowWebhookReceipt[]
  outboxEvents          OutboxEvent[]
  activityEvents        ActivityEvent[]
  activityTriggerClaims ActivityTriggerClaim[]
  activitySourceCursors ActivitySourceCursor[]
  domains               OrganizationDomain[]
  allowedDomains        PlatformAllowedDomain[]
  scimTokens            ScimToken[]
  apiKeys               ApiKey[]
  apiAccessTokens       ApiAccessToken[]
  identityProviders     IdentityProvider[]
  teams                 Team[]
  featureGrants         FeatureGrant[]
  workspaceFolders      WorkspaceFolder[]
  agentTeammates        AgentTeammate[]
  adoptionWeeks         AdoptionWeek[]
  agentCohortWeeks      AgentCohortWeek[]
  slackIdentities       SlackIdentity[]
  slackChannelBindings  SlackChannelBinding[]
  /// How this workspace's people must sign in.
  ///   optional (default) — any admitted method, exactly as before.
  ///   required — only an identity brokered by a federated IdP. Password and
  ///     social sign-in are refused for this workspace's verified domains.
  /// Defaulted to `optional` so enabling it is always a deliberate act: a
  /// default of `required` would lock every existing workspace out on deploy.
  ssoEnforcement        String                  @default("optional")

  @@map("organizations")
}

/// A named shared folder in the workspace agent tree. AgentTask.folder remains
/// the denormalized assignment so existing agents and exports stay compatible;
/// this row makes an empty folder durable and visible to every workspace member.
model WorkspaceFolder {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  /// @default(now()) declares what the table has always had: the creating
  /// migration wrote DEFAULT CURRENT_TIMESTAMP, the model did not, and the
  /// resulting drift failed CI's migrations job on every run since. Declared
  /// rather than dropped because dropping it is the direction that can break
  /// something — Prisma sets this field itself, but a raw INSERT omitting it
  /// would start violating NOT NULL.
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspace_folders")
}

/// A pending invitation to join an organization. The plaintext token is emailed
/// (and shown once to the inviter); only its SHA-256 hash is stored. Accepting
/// moves the invited user into this org with `role`. Membership is a single-org
/// FK on User, so accepting reassigns the user's organizationId.
model Invitation {
  id               String    @id @default(cuid())
  email            String
  organizationId   String    @db.Uuid
  // 'ADMIN' | 'USER' — validated at the API layer (kept as text to avoid an
  // enum-typed column on a brand-new table).
  role             String    @default("USER")
  tokenHash        String    @unique
  // 'PENDING' | 'ACCEPTED' | 'REVOKED'
  status           String    @default("PENDING")
  invitedById      String?
  acceptedByUserId String?
  expiresAt        DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  acceptedAt       DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model User {
  id                     String    @id @default(cuid())
  supabaseId             String    @unique @db.Uuid
  email                  String?
  name                   String?
  imageUrl               String?
  // People.ai membership id from the MCP OAuth context — the delegated
  // identity used for user-scoped People.ai tool calls.
  peopleAiMembershipId   String?
  role                   UserRole  @default(USER)
  /// Platform tier, independent of the org role. null for everyone outside
  /// Backstory. 'staff' = internal employee; 'reviewer' = may decide and
  /// publish catalogue submissions.
  platformRole           String?
  organizationId         String?   @db.Uuid
  isActive               Boolean   @default(true)
  lastSeenAt             DateTime? @db.Timestamptz(6)
  /// Watermark for the per-person daily run cap. The cap counts runs since the
  /// LATER of midnight UTC and this stamp, so an operator can hand someone a
  /// fresh allowance mid-day. Null means the plain midnight window applies.
  /// A stamp cannot be gamed to LENGTHEN the window — see checkDailyRunAllowance.
  runAllowanceResetAt    DateTime? @db.Timestamptz(6)
  /// Watermark for "clear my notifications": the bell lists only rows created
  /// strictly after this. On the READER, not on the notifications, because a
  /// row with a null userId belongs to the whole workspace — deleting on clear
  /// would empty a colleague's bell. Null means nothing has been cleared.
  notificationsClearedAt DateTime? @db.Timestamptz(6)
  timezone               String    @default("UTC")
  metadata               Json?
  /// Stable identity supplied by SCIM. Unique only inside a workspace.
  scimExternalId         String?
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions          AgentExecution[]
  templates           AgentTemplate[]
  flowTemplates       FlowTemplate[]
  integrations        Integration[]
  ownedAgents         AgentTask[]
  peopleAiConnections PeopleAiConnection[]
  mcpConnections      McpConnection[]
  nangoConnections    NangoConnection[]
  httpCredentials     HttpCredential[]
  teamMemberships     TeamMember[]
  featureGrants       FeatureGrant[]
  apiKeys             ApiKey[]
  slackIdentities     SlackIdentity[]

  @@unique([organizationId, scimExternalId])
  @@index([organizationId])
  @@map("users")
}

/// A domain becomes authoritative only after its DNS TXT challenge verifies.
/// A group of people inside a workspace.
///
/// Distinct from ROLE, which says what someone may do. A team says who they
/// work with, and is what feature entitlements are granted to in practice —
/// "enable this for the enterprise sales team" is the request that actually
/// arrives, not "enable it for these fourteen user ids".
model Team {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  features     FeatureGrant[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  /// Team-local standing. Does NOT confer workspace permissions — a team lead
  /// is not an admin. Keeping the two separate is what stops team membership
  /// becoming a back door to authority.
  teamRole  String   @default("member") // 'member' | 'lead'
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// A feature switched on (or explicitly off) for a workspace, a team, or one
/// person.
///
/// Three scopes rather than one because that is how the request arrives:
/// pilots go to a team, exceptions go to a person, and the plan goes to the
/// workspace. Collapsing them would mean re-granting a whole team one user at
/// a time and losing the reason it was granted.
model FeatureGrant {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Registry key from src/lib/authz/features.ts.
  feature        String
  /// Exactly one of teamId / userId is set for a scoped grant; both null means
  /// the grant applies to the whole workspace.
  teamId         String?
  userId         String?
  /// false is an explicit DENY, which beats any grant. An exception has to be
  /// expressible, or the only way to exclude one person from a workspace-wide
  /// feature is to stop granting it to everyone.
  enabled        Boolean  @default(true)
  /// Why. Read months later when deciding whether it can be removed.
  reason         String   @default("")
  grantedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, feature, teamId, userId])
  @@index([organizationId, feature])
  @@index([userId])
  @@map("feature_grants")
}

/// A customer-owned identity provider federated into this workspace.
///
/// Okta is the platform's own IdP, but a customer accessing the platform
/// externally brings their own — that is the whole point of an external
/// delivery surface. The SAML/OIDC connection itself lives in Supabase (which
/// brokers the protocol); this row is the record of WHICH provider serves which
/// workspace, so the mapping is manageable, auditable and enforceable from
/// inside the product rather than only from a Supabase dashboard.
model IdentityProvider {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  /// Display name shown on the sign-in surface ("Acme Okta").
  name           String
  protocol       String    @default("saml") // 'saml' | 'oidc'
  /// Supabase SSO provider id. Null until an operator finishes provisioning it
  /// there — the row exists first so the intent is recorded and reviewable.
  supabaseSsoId  String?   @unique
  /// SAML entity id / OIDC issuer, for operator reference and de-duplication.
  issuer         String?
  status         String    @default("pending") // pending | active | disabled
  createdById    String?
  lastUsedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains      OrganizationDomain[]

  @@index([organizationId, status])
  @@map("identity_providers")
}

model OrganizationDomain {
  id                    String    @id @default(cuid())
  organizationId        String    @db.Uuid
  domain                String    @unique
  verificationTokenHash String
  verificationToken     String
  status                String    @default("pending") // pending | verified
  verifiedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  /// Which IdP signs in this domain's people. Null = the platform default
  /// (Okta / social), which is what every existing domain keeps.
  identityProviderId    String?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: removing an IdP must not delete the customer's
  // verified domain — that would silently un-verify their whole workspace and
  // is far harder to recover from than re-pointing the domain.
  identityProvider IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([identityProviderId])
  @@map("organization_domains")
}

/// One LLM or embedding API call. Detail rows for internal cost visibility;
/// denormalized totals live on AgentExecution/FlowRun so list views never
/// aggregate. Rows older than 90 days are swept by the retention cron — the
/// totals survive, so historical run cost stays visible after detail ages out.
///
/// Deliberately declares no relation fields: the three parent ids are nullable
/// and point at different models, so keeping them as plain columns avoids three
/// optional relations on hot models for a table only ever queried directly.
model LlmCall {
  id               String   @id @default(cuid())
  organizationId   String   @db.Uuid
  /// Who this spend belongs to, copied from the parent run at write time.
  ///
  /// Denormalized on purpose. This model declares no relations (see above), and
  /// per-person token totals otherwise need a join the tenant guard cannot see
  /// through — the operator console would have to fall back to agent-plane
  /// tokens and silently under-report anyone who mostly runs flows.
  ///
  /// Nullable: rows written before this column existed carry no attribution,
  /// and a run without an owner (system/scheduled dispatch) never had one. The
  /// historical gap closes on its own once the 90-day retention sweep passes.
  userId           String?
  agentExecutionId String?
  flowRunId        String?
  flowRunStepId    String?
  /// agent_turn | structured | headline | embedding | eval_judge
  surface          String
  provider         String
  model            String
  inputTokens      Int      @default(0)
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  outputTokens     Int      @default(0)
  /// Wall-clock for the call, in milliseconds.
  ///
  /// Nullable rather than defaulted to 0: rows written before this column
  /// existed have no measurement, and a 0 default would be indistinguishable
  /// from an instant call and would pull the console's per-model averages down
  /// by however much history predates it.
  latencyMs        Int?
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  /// Which price table produced costUsd. 'unknown' means the model had no rate.
  priceVersion     String
  createdAt        DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([flowRunId])
  // Per-person spend for the operator console, over a time window.
  @@index([userId, createdAt])
  // Per-model cost and latency for the Models console, and the Claude-usage
  // caps, which both scan a day/window grouped by provider and model.
  @@index([provider, model, createdAt])
  @@map("llm_calls")
}

/// One graded model evaluation — a bench fixture run or one side of a shadow
/// comparison. The evidence base for "can a cheaper model do this job", kept in
/// the database rather than a JSON artifact so the operator console can chart
/// it per model over time, for ANY model that gets added.
///
/// Same posture as LlmCall: no relations, written via systemPrisma only, and —
/// critically for shadow rows, which are graded on real tenant prompts — it
/// stores scores and token counts, NEVER text. The judge's reasoning is only
/// kept for bench rows, whose inputs are checked-in fixtures we authored.
model ModelEvalResult {
  id             String   @id @default(cuid())
  /// 'bench' — checked-in fixture, comparable across models and time.
  /// 'shadow' — sampled production task, one row per side of the pair.
  kind           String
  provider       String
  model          String
  /// bench: the fixture name. shadow: the surface (e.g. 'flow.ai_step').
  subject        String
  /// Judge score 0..1. Null when the run broke before judging.
  score          Decimal? @db.Decimal(4, 3)
  /// Bench only: whether deterministic structural asserts held.
  pass           Boolean?
  /// Bench only — see the header: shadow reasoning could quote tenant text.
  reasoning      String?
  /// Which model graded this row. A judge is itself a model with tastes; a
  /// score is only comparable to scores graded by the same judge.
  judgeModel     String?
  /// Shadow: links the two sides of one comparison.
  pairId         String?
  /// Shadow: true on the row for the model that actually served production.
  champion       Boolean?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  latencyMs      Int?
  costUsd        Decimal  @default(0) @db.Decimal(12, 6)
  /// Shadow only, for spend accounting. Bench rows are platform-level (null).
  organizationId String?  @db.Uuid
  /// Bumped whenever fixture dispatch or judging semantics change (see
  /// CURRENT_HARNESS_VERSION in src/lib/eval/harness.ts). Rows from before this
  /// column existed are labeled 'pre-2026-08-20' by the migration default, so
  /// the admin console's rolling averages can exclude them instead of blending
  /// scores from the inverted-score era into current numbers.
  harnessVersion String   @default("pre-2026-08-20")
  /// Bench only: the per-sample {score, reasoning} judge verdicts backing the
  /// mean stored in `score` — the evidence for the number, not just the number.
  samples        Json?
  createdAt      DateTime @default(now())

  @@index([kind, model, createdAt])
  @@index([pairId])
  @@map("model_eval_results")
}

/// Platform-level access gate: which email domains may reach the product at
/// all. Deliberately SEPARATE from OrganizationDomain — that model answers
/// "does this domain belong to workspace X" for SSO enforcement, and
/// overloading it would let a customer verifying a domain silently grant
/// itself platform access.
///
/// COMPANY_EMAIL_DOMAINS (src/lib/auth/company-domain.ts) stays hardcoded and
/// is NOT represented here, so no table edit can lock staff out.
model PlatformAllowedDomain {
  id             String    @id @default(cuid())
  /// Bare hostname, lowercased. Exact match only — no wildcards.
  domain         String    @unique
  /// The shared workspace every user from this domain joins.
  organizationId String    @db.Uuid
  note           String    @default("")
  addedByUserId  String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  /// Set to disable without losing the audit trail. Null = active.
  disabledAt     DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("platform_allowed_domains")
}

/// A super-admin grant addressed to an EMAIL rather than an existing user, so
/// reviewers can be added before their first sign-in. Existing accounts are
/// promoted directly (users.platformRole); a row here is claimed — and stamped,
/// not deleted, to keep the audit trail — when an account with this email is
/// provisioned. Platform table: no tenant owns it, RLS denies the tenant role.
model PlatformStaffEmail {
  id              String    @id @default(cuid())
  /// Lowercased, exact match.
  email           String    @unique
  addedByUserId   String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  /// Stamped when a newly provisioned account consumed this grant.
  claimedAt       DateTime? @db.Timestamptz(6)
  claimedByUserId String?

  @@map("platform_staff_emails")
}

/// Bearer credentials accepted by the SCIM 2.0 provisioning surface. Only a
/// SHA-256 digest is stored; plaintext is shown once at mint time.
model ScimToken {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  name           String
  tokenHash      String    @unique
  prefix         String
  createdById    String
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@map("scim_tokens")
}

/// Customer API key. Scopes are a JSON string array so new public API
/// capabilities do not require an enum migration.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  name           String
  /// Public half of a client-credentials pair. Non-secret: safe to display,
  /// log and put in a support ticket, which is exactly why it exists — the
  /// single-token scheme forced people to paste the secret to identify a key.
  /// Null on keys minted before the pair existed; those still authenticate
  /// with the bearer token alone.
  clientId       String?   @unique
  /// Hash of the single bearer token (legacy) or of the client SECRET (pairs).
  keyHash        String    @unique
  prefix         String
  scopes         Json      @default("[]")
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessTokens ApiAccessToken[]

  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

/// A short-lived access token issued from a client-credentials exchange.
///
/// The persistent key stops being the thing sent on every request: callers
/// exchange the pair once for a token that expires in minutes. A leaked
/// request log or proxy trace then exposes something already dead rather than a
/// credential valid until someone notices.
///
/// Stored and hashed rather than signed and stateless, deliberately: a
/// stateless token cannot be revoked before it expires, and immediate
/// revocation is the property the rest of this system is built around. The
/// lookup is one indexed read on a hash we already compute.
model ApiAccessToken {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  apiKeyId       String
  tokenHash      String    @unique
  /// Snapshotted at issue: narrowing a key's scopes must not silently widen a
  /// token already in flight, and a token must never outrank its key.
  scopes         Json      @default("[]")
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  lastUsedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, revokedAt])
  @@index([expiresAt])
  @@map("api_access_tokens")
}

/// A named persona ("avatar") that owns a GROUP of agents.
///
/// The roster people manage is made of teammates, not tasks: one avatar can run
/// several agents doing different jobs, and installing a template adds another
/// job to an existing teammate instead of spawning a stranger. Agents without a
/// teammate stay valid and render as solo cards, so this is additive — nothing
/// had to be backfilled.
model AgentTeammate {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  name           String
  /// AI-generated 1–2 word role covering what this teammate's agents do.
  /// Cleared when its roster changes so it regenerates from the new mix.
  roleLabel      String?
  /// Chosen avatar. The face is derived from this string, so overriding it is
  /// how a person picks a different look; null falls back to the row id, which
  /// is what every avatar used before they were choosable.
  avatarSeed     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       AgentTask[]

  @@index([organizationId])
  @@map("agent_teammates")
}

model AgentTask {
  id             String    @id @default(cuid())
  type           String    @default("agent")
  priority       String    @default("MEDIUM")
  agentType      String    @default("CUSTOM")
  description    String    @db.Text
  objective      String    @db.Text
  goal           String?   @db.Text
  context        Json      @default("{}")
  schedule       Json      @default("{}")
  status         String    @default("ACTIVE")
  folder         String?
  visibility     String    @default("shared")
  organizationId String    @db.Uuid
  userId         String?
  /// The avatar this agent works under. Null = a solo agent with its own card.
  /// SetNull on delete: removing a teammate ungroups its agents, never deletes
  /// the work they do.
  teammateId     String?
  /// See Flow.quarantinedAt — set when the owner was deprovisioned.
  quarantinedAt  DateTime? @db.Timestamptz(6)
  /// Set when the agent is soft-deleted (status -> 'DELETED'). Null for a live
  /// agent AND for anything deleted before this column existed — `updatedAt`
  /// moves on every edit, so historical deletion dates are unrecoverable and
  /// are deliberately left null rather than guessed.
  deletedAt      DateTime? @db.Timestamptz(6)
  metadata       Json?
  lastExecutedAt DateTime?
  /// When the scheduler should next LOOK at this row — a pre-filter, never the
  /// authority (the tick still calls isDue on everything it reads).
  /// NULL means "recompute me": always read, which is what an un-backfilled row
  /// or a just-edited schedule looks like. See src/lib/scheduling/next-run.ts.
  nextRunAt      DateTime? @db.Timestamptz(6)
  executionCount Int       @default(0)
  lastResult     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  teammate             AgentTeammate?        @relation(fields: [teammateId], references: [id], onDelete: SetNull)
  executions           AgentExecution[]
  signalSubscriptions  SignalSubscription[]
  chatMessages         AgentChatMessage[]
  chatSessions         AgentChatSession[]
  connectors           AgentConnector[]
  memories             AgentMemory[]
  slackChannelBindings SlackChannelBinding[]

  @@index([organizationId, status])
  @@index([userId])
  // The gallery groups a workspace's roster by avatar on every load.
  @@index([teammateId])
  // The scheduler's cursor scan: `status = 'ACTIVE' ORDER BY id`, across all
  // orgs. The [organizationId, status] index above can't serve it — wrong
  // leading column — so without this the sweep is a full table scan every tick.
  @@index([status, id])
  // The scheduler's due-range read: `status = 'ACTIVE' AND (nextRunAt IS NULL OR
  // nextRunAt <= now)`. Replaces a full cursor scan of every active agent on
  // every tick, which was O(table) once a minute and forever growing.
  @@index([status, nextRunAt])
  @@map("agent_tasks")
}

/// Typed binding between an agent and a connector it uses. Replaces matching
/// fuzzy strings against the agent's `metadata.integrations` JSON with real
/// rows: a canonical connector key, its plane (kind), and — for a per-org MCP
/// connection — a foreign key with referential integrity (deleting the
/// connection nulls the binding instead of leaving a dangling string).
model AgentConnector {
  id              String   @id @default(cuid())
  agentTaskId     String
  organizationId  String   @db.Uuid
  /// Canonical selection key (registry key or connection name).
  connectorKey    String
  /// Plane: 'builtin' | 'nango' | 'backstory' | 'mcp' | 'external'.
  kind            String   @default("external")
  /// Optional FK to a specific per-org MCP connection this binding targets.
  mcpConnectionId String?
  config          Json     @default("{}")
  createdAt       DateTime @default(now())

  agentTask     AgentTask      @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  mcpConnection McpConnection? @relation(fields: [mcpConnectionId], references: [id], onDelete: SetNull)

  @@unique([agentTaskId, connectorKey])
  @@index([organizationId])
  @@index([mcpConnectionId])
  @@map("agent_connectors")
}

/// Durable, agent-scoped memory: answers to clarifying questions, learnings
/// distilled from executions, and proactive suggestions. Retrieved by kind +
/// status to ground future runs without re-asking or re-deriving.
model AgentMemory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  agentId        String
  /// What this memory is ABOUT, when it is about one thing — an account id, a
  /// CRM record id, an opportunity. Null means the agent knows it generally.
  ///
  /// Memory was filed under the agent alone, which made "what have we learned
  /// about Acme" unanswerable: every learning sat under whichever agent
  /// happened to acquire it. Recall reads the resource's memories AND the
  /// agent's general ones, so scoping narrows without hiding.
  resourceId     String?
  kind           String // 'user_answer' | 'learning' | 'suggestion'
  title          String
  content        String  @db.Text
  question       String? @db.Text
  /// SHA-256 of the normalized title+content, so the same learning recorded
  /// twice for the same agent and resource collapses to one row. Embedding
  /// dedup only covers suggestions, and only when embeddings are configured.
  contentHash    String?
  embedding      Json?

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  sourceExecutionId String?
  status            String    @default("open") // 'open' | 'dismissed' | 'superseded'
  timesUsed         Int       @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AgentTask    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, agentId, resourceId, contentHash], map: "agent_memories_content_dedup")
  @@index([organizationId, agentId, kind, status])
  @@index([organizationId, agentId, resourceId, status])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "agent_memories_embedding_vec_hnsw")
  @@map("agent_memories")
}

// Agent-scoped assistant chat (persistent per agent + user, not per execution).
// Additive: new table only. `metadata` carries assistant proposals and their
// applied-at marker, mirroring the JSON grab-bag pattern used elsewhere.
model AgentChatMessage {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Groups messages into a conversation. Nullable so pre-existing flat threads
  // (before sessions) read as one implicit "Earlier conversation".
  sessionId      String?
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  agentTask AgentTask         @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  session   AgentChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_chat_messages")
}

// A single assistant conversation for one agent + user. Multiple sessions per
// agent give users a "new chat" and a browsable history, scoped per agent.
model AgentChatSession {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Auto-derived from the first user message; null until the first message.
  title          String?
  /// Slack thread this conversation lives in, when it was started by a mention.
  /// Unique together so a follow-up in the same thread continues the SAME
  /// session instead of starting a new one every time. Null for in-app
  /// sessions, and Postgres treats NULLs as distinct in a unique index, so any
  /// number of them coexist.
  slackChannelId String?
  slackThreadTs  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentTask AgentTask          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  messages  AgentChatMessage[]

  @@unique([slackChannelId, slackThreadTs])
  @@index([agentTaskId, userId, updatedAt])
  @@map("agent_chat_sessions")
}

// Inbound People.ai Sales AI event (webhook or poller). Immutable once
// written; the router turns matching signals into agent executions.
model Signal {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // One of the documented SalesAI events: deal.score_updated,
  // deal.risk_detected, deal.stage_changed, forecast.updated,
  // insight.generated, stakeholder.engagement_changed.
  type           String
  accountId      String?
  opportunityId  String?
  stakeholderId  String?
  payload        Json
  // Replay guard: provider event id (or a content hash fallback). Unique PER
  // ORG (see @@unique below), not globally — a raw provider event id from one
  // tenant must never dedupe-drop another tenant's signal.
  dedupeKey      String
  provenanceUrl  String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionRuns AgentExecution[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, receivedAt])
  @@index([organizationId, type])
  @@map("signals")
}

/// Normalized, persisted provider-activity event (Slack messages, Salesforce
/// record changes, GitHub events, ...) — the substrate exactly-once flow
/// triggers and graph-RAG indexing are built on. Duplicate provider deliveries
/// are acks, not new rows (@@unique below), same as Signal.
model ActivityEvent {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  source          String // 'slack' | 'salesforce' | 'github' | 'nango:<provider>'
  sourceEventId   String
  kind            String // normalized verb: 'message.posted' | 'record.updated' | 'pr.opened' | ...
  occurredAt      DateTime
  actorExternalId String?
  // Plain text, NOT @db.Uuid: User.id is a cuid (see model User), not a uuid —
  // matching NangoConnection.userId's convention. The original migration
  // typed this column uuid, which any real user id fails to write to at all;
  // fixed alongside the writer that first needed to populate a non-null value
  // (Task 3 of the activity-event substrate plan).
  ownerUserId     String?
  visibility      String       @default("org") // 'org' | 'private'
  selfOrigin      Boolean      @default(false)
  backfill        Boolean      @default(false)
  chainDepth      Int          @default(0)
  subject         Json? // { channelId?, threadTs?, recordId?, repo?, ... }
  payload         Json
  indexedAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, sourceEventId])
  @@index([organizationId, indexedAt])
  @@index([organizationId, source, kind, createdAt])
  @@map("activity_events")
}

// Routing rule: signal type + JSON filter → run an agent, with the signal
// injected as structured context.
model SignalSubscription {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  signalType     String
  // Shallow equality filter over signal payload/entity fields, e.g.
  // {"risk_level": "high"}. Empty object matches everything.
  filter         Json     @default("{}")
  agentTaskId    String
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId, signalType, isActive])
  @@map("signal_subscriptions")
}

// A rep-defined "custom signal": a saved SalesAI question (e.g. "who's talking
// about this account?", "what's the next best action?") reused here — People.ai
// exposes no signal catalog, so the definition lives on our side and runs via
// the ask_sales_ai_about_account/opportunity MCP tools. Per rep (owner), org
// scoped, matching the graph isolation posture.
model CustomSignal {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String
  name           String
  question       String   @db.Text
  // 'account' | 'opportunity' — which ask_sales_ai tool it runs against.
  scope          String   @default("account")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, updatedAt])
  @@map("custom_signals")
}

model AgentExecution {
  id               String    @id @default(cuid())
  agentType        String
  agentTemplateId  String?
  agentTaskId      String?
  // Replay/duplicate guard for signal-triggered runs (signalId:agentId).
  idempotencyKey   String?
  signalId         String?
  status           String    @default("pending")
  input            Json
  output           Json?
  error            String?
  executionTime    Int?      @default(0)
  trigger          Json
  metadata         Json?
  model            String?
  transcript       Json?
  /// Fresh (non-cached) prompt tokens only, as of the cache-column split below.
  ///
  /// Rows written BEFORE this split fold cacheReadTokens+cacheWriteTokens into
  /// this column with both cache columns at their 0 default — that is a
  /// re-labeling, not a data loss: inputTokens + cacheReadTokens +
  /// cacheWriteTokens is the same total for a legacy row as for a new one, so
  /// any reader that sums all three across old and new rows stays correct.
  /// Only a reader that treats inputTokens ALONE as "the prompt" changes
  /// meaning at the split point — from "everything sent" to "the part not
  /// served from cache".
  inputTokens      Int       @default(0)
  /// Tokens that WROTE a new prompt-cache entry this turn (billed ~1.25x).
  /// 0 for every row predating the split (see inputTokens doc-comment).
  cacheWriteTokens Int       @default(0)
  /// Tokens served FROM the prompt cache this turn (billed ~0.1x). 0 for every
  /// row predating the split (see inputTokens doc-comment).
  cacheReadTokens  Int       @default(0)
  outputTokens     Int       @default(0)
  /// Denormalized sum of this execution's LlmCall rows, so list views never
  /// aggregate. Internal ops estimate — see src/lib/usage/pricing.ts.
  costUsd          Decimal   @default(0) @db.Decimal(12, 6)
  userId           String
  organizationId   String    @db.Uuid
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTemplate AgentTemplate?     @relation(fields: [agentTemplateId], references: [id], onDelete: SetNull)
  agentTask     AgentTask?         @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  signal        Signal?            @relation(fields: [signalId], references: [id], onDelete: SetNull)
  workflowSteps WorkflowStep[]
  events        WorkflowEvent[]
  messages      ExecutionMessage[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startedAt])
  @@index([agentTaskId])
  // Per-org in-flight count (src/lib/queue/org-capacity.ts), read once per
  // scheduler tick to stop one workspace occupying the whole worker pool.
  @@index([organizationId, status])
  @@map("agent_executions")
}

model ExecutionMessage {
  id          String   @id @default(cuid())
  executionId String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_messages")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  type           String
  level          String    @default("info")
  title          String
  body           String?   @db.Text
  agentTaskId    String?
  executionId    String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   @db.Uuid
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  executionId String
  node        String
  status      String
  input       Json      @default("{}")
  output      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  execution AgentExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  events    WorkflowEvent[]

  @@index([executionId, createdAt])
  @@map("workflow_steps")
}

model WorkflowEvent {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  kind        String
  payload     Json?
  ts          DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      WorkflowStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, ts])
  @@map("workflow_events")
}

// Append-only audit trail of consequential actions (tool writes, config
// changes, connections, approvals). Never updated or deleted in normal
// operation; exportable per org for enterprise compliance.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  actorUserId    String?
  actorKind      String   @default("user") // 'user' | 'agent' | 'system'
  action         String // e.g. 'tool.write', 'agent.config_changed'
  resourceType   String?
  resourceId     String?
  tool           String?
  executionId    String?
  // Hash (not contents) of the payload — proves what happened without storing
  // potentially sensitive tool arguments in the audit row.
  payloadHash    String?
  detail         Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("audit_events")
}

// A pending outbound-write approval. The run parks (waiting_for_input) until an
// approver decides; on approval the write proceeds, on rejection it is skipped.
model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  executionId    String
  tool           String
  summary        String    @db.Text
  payload        Json
  status         String    @default("pending") // 'pending' | 'approving' | 'approved' | 'rejected' | 'failed' | 'superseded'
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("approval_requests")
}

model AgentTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  type            String
  configuration   Json?
  isActive        Boolean  @default(true)
  schedule        String?
  priority        String   @default("MEDIUM")
  metadata        Json?
  // Where the template came from: 'user' (hand-authored) or 'ai_generated'
  // (proposed by the auto-generation engine, sub-project C).
  source          String   @default("user")
  // 'org' = visible only to the owning org (default); 'global' = published to
  // the shared community library, readable cross-org. Existing rows are
  // backfilled to 'global' by the migration to preserve prior behavior.
  visibility      String   @default("org")
  /// 'none' = not in the catalogue; 'published' = approved through review;
  /// 'legacy_published' = was global before review existed, pending audit.
  catalogueStatus String   @default("none")
  userId          String
  organizationId  String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]

  @@index([organizationId, isActive])
  @@index([organizationId, visibility])
  @@map("agent_templates")
}

model Integration {
  id             String    @id @default(cuid())
  userId         String
  organizationId String    @db.Uuid
  provider       String
  expiresAt      DateTime? @db.Timestamptz(6)
  scopes         String[]  @default([])
  status         String    @default("connected")
  failCount      Int       @default(0)
  lastError      String?   @db.Text
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Scoped per workspace, not globally per user: the same person may hold a
  // connection to the same provider in two workspaces over time, and the old
  // global key meant a stale row from a workspace they had LEFT permanently
  // occupied the slot, making the provider un-reconnectable. See
  // src/lib/org-transfer.ts.
  @@unique([organizationId, userId, provider])
  @@index([organizationId, provider])
  @@map("integrations")
}

// Per-user People.ai Sales AI connection: encrypted mcp_* tokens from the
// mcp.people.ai OAuth flow, plus the team/membership identity they resolve to.
// One connection per user per workspace; agents read People.ai as this user.
model PeopleAiConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String
  teamId         String?
  membershipId   String?
  scope          String?
  /// Normalised form of `scope`, for the same review surface as the other
  /// credential kinds. `scope` stays as the provider sent it.
  grantedScopes  String[]  @default([])
  accessToken    String // encrypted (src/lib/crypto/secrets.ts)
  refreshToken   String? // encrypted
  status         String    @default("active") // 'active' | 'refresh_failed' | 'revoked'
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("people_ai_connections")
}

model McpConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // Personal connection when set (e.g. the per-user Backstory MCP row);
  // null = org-shared server added via the connections page.
  userId         String?
  // Platform-managed provider slug ('backstory'); null = user-added server.
  provider       String?
  name           String
  description    String?
  serverUrl      String
  authType       String    @default("none") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json      @default("{}") // encrypted secret blob + non-secret fields
  /// Scopes the provider ACTUALLY granted, recorded so an over-scoped
  /// connection is visible. Previously parsed from the token response and
  /// thrown away, which made a read-only and a full-write grant identical rows.
  grantedScopes  String[]  @default([])
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  healthStatus   String    @default("unknown") // unknown | healthy | unhealthy | schema_changed
  lastError      String?   @db.Text
  toolSchemaHash String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentBindings AgentConnector[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, isActive])
  @@map("mcp_connections")
}

// Mirror of a Nango connected account, scoped per-organization. Nango owns
// the credentials; we only persist connection ids and health for listing.
model NangoConnection {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  connectionId      String
  providerConfigKey String
  provider          String?
  status            String   @default("connected")
  /// See McpConnection.grantedScopes. Nango holds the credential, so this is
  /// the only place the granted scope is visible to us at all.
  grantedScopes     String[] @default([])
  lastError         String?  @db.Text
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // userId was a dangling column for a long time: no relation, no foreign key,
  // so nothing guaranteed it pointed at a real user and it could not be joined.
  // The owner-liveness guard needs the join, and an unattributable credential is
  // the exact thing the revocation spine exists to eliminate.
  //
  // Cascade, NOT SetNull: `userId: null` MEANS org-shared here, so nulling a
  // departed person's row would silently promote their personal connection into
  // one the whole workspace can use — the opposite of revoking it.
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connectionId])
  @@index([organizationId, providerConfigKey])
  @@index([userId])
  @@map("nango_connections")
}

/// Per-connection checkpoint for backfill workers: how far a source has been
/// paged, so backfill resumes idempotently instead of re-walking history.
/// Backfilled events never fire triggers (ActivityEvent.backfill = true).
model ActivitySourceCursor {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  source           String
  connectionId     String
  cursor           Json
  lastBackfilledAt DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, connectionId])
  @@map("activity_source_cursors")
}

// Per-organization secret for built-in integrations (e.g. the Granola API
// key). authConfig holds the encrypted blob produced by buildAuthConfig().
model IntegrationSecret {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  provider       String
  authType       String    @default("api_key") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json      @default("{}") // encrypted secret blob + non-secret fields
  /// See HttpCredential.lastRotatedAt.
  lastRotatedAt  DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, isActive])
  @@map("integration_secrets")
}

// Reusable encrypted credentials for generic HTTP Request nodes. A flow stores
// only this row's id; plaintext secrets never enter graph JSON or run logs.
// `allowedHost` binds a credential to the API host it was verified against so
// it cannot be silently replayed to an unrelated endpoint.
model HttpCredential {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  /// Owning person. Null = a legacy workspace-shared credential: every agent in
  /// the org acted through it, so no action taken with it was attributable to
  /// anyone. New credentials are always owned; null exists only for rows that
  /// predate ownership and is what the /credentials page flags for migration.
  userId         String?
  name           String
  authType       String
  allowedHost    String
  secretConfig   String    @db.Text
  status         String    @default("verified")
  /// When the SECRET was last replaced — not when the row was last touched.
  /// Staleness is measured from here, so a credential rotated last week reads
  /// as fresh however old the row is.
  lastRotatedAt  DateTime?
  /// Optional: we cannot rotate a third party's key on their behalf, so forcing
  /// an expiry here would break the integration on a date nobody chose.
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Cascade, NOT SetNull — same reasoning as NangoConnection: `userId: null`
  // MEANS org-shared here, so nulling a departed person's row would silently
  // promote their personal credential into one the whole workspace can use,
  // the exact opposite of revoking it.
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, authType, allowedHost])
  @@index([userId])
  @@map("http_credentials")
}

/// A visual agent pipeline: a graph of steps, each running a workspace agent
/// via runAgentExecution. Distinct from WorkflowStep/WorkflowEvent (those are a
/// single agent's internal tool-call trace). See docs/superpowers/specs.
model Flow {
  id               String    @id @default(cuid())
  name             String
  description      String    @default("")
  /// Emoji shown on the flow's card and in the builder ('' = the generic
  /// Workflow glyph). Seeded from the template's icon on instantiate.
  icon             String    @default("")
  status           String    @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  /// See AgentTask.nextRunAt — same contract, same pre-filter role.
  nextRunAt        DateTime? @db.Timestamptz(6)
  trigger          Json      @default("{}") // { type: 'manual'|'schedule'|'signal', ... }
  graph            Json      @default("{}") // working draft: { nodes, edges }
  publishedGraph   Json? // the live version scheduled/triggered runs execute
  /// Literal credentials the save-time scanner found in the graph. Advisory:
  /// a save is never blocked (that reads as data loss to the author), but a
  /// flow carrying a hardcoded key says so on its own card until it is fixed.
  /// Written by the Prisma extension on every graph write, so it cannot go
  /// stale relative to the graph it describes.
  secretFindings   Json?
  secretScanAt     DateTime?
  version          Int       @default(1) // bumped on each publish
  visibility       String    @default("shared")
  /// SHA-256 digest of the rotatable cross-workspace share-link token. The raw
  /// token is a bearer credential — it opens a flow from another workspace, or
  /// with no session at all — so it is never stored. It is returned exactly
  /// once, from the mint/rotate response, and every later presentation is
  /// resolved by hashing what the caller sent and matching this digest.
  shareTokenDigest String?   @unique
  shareRole        String    @default("view") // role a share-link grants: 'view' | 'edit'
  /// May the share token be opened WITHOUT signing in? Anonymous opens land on
  /// a separate read-only page with a sanitized graph — never the builder, and
  /// never 'edit' regardless of shareRole.
  shareAnonymous   Boolean   @default(false)
  /// Count of anonymous opens, surfaced to the owner so a public link is never
  /// silently accumulating traffic.
  anonymousViews   Int       @default(0)
  folder           String    @default("") // workbook-style grouping ('' = ungrouped)
  // Polling-trigger dedupe state ({ seen: string[] }) — the keys of items already
  // emitted, so a poll only starts the flow for genuinely new records.
  pollCursor       Json?
  /// Import report ({ notes: [{code, severity, message, nodeId?}], blocking }):
  /// what the importer couldn't translate faithfully plus the post-import
  /// validation blocker count. Null once the user clears the notes (or for
  /// flows that weren't imported).
  importNotes      Json?
  /// Denormalized match index for the activity-event dispatcher (Task 6) —
  /// NOT the source of truth (that's `trigger`'s JSON, synced from the
  /// builder's trigger node by `triggerFromGraph`'s write path on every
  /// save/publish/import/instantiate). Kept in lockstep with `trigger` so the
  /// dispatcher can do one indexed `WHERE organizationId = ? AND
  /// activitySource = ?` scan instead of a full-table scan decoding JSON on
  /// every ACTIVE flow. `activitySource` is the app the flow listens to
  /// ('slack', 'salesforce', 'nango:<provider>', ...) — null for every
  /// non-event trigger type (manual/schedule/webhook/signal/poll). A 'slack'
  /// trigger is sugar over the same matcher: it always writes
  /// activitySource = 'slack', activityKinds = ['message.posted'].
  activitySource   String?
  /// The normalized `ActivityKind` verbs (see ACTIVITY_KINDS in
  /// lib/activity/normalize.ts) this flow fires on. Empty for non-event
  /// triggers, and for an 'activity' trigger with no kinds configured yet.
  activityKinds    String[]  @default([])
  organizationId   String    @db.Uuid
  userId           String?
  /// Set when the owner was deprovisioned. Quarantined work never dispatches
  /// and appears in the admin claim queue until someone takes ownership.
  /// Deliberately ORTHOGONAL to `status`: overwriting status would destroy the
  /// prior value, so a claimed draft would come back as ACTIVE.
  quarantinedAt    DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs            FlowRun[]
  versions        FlowVersion[]
  reviews         FlowReview[]
  editSnapshots   FlowEditSnapshot[]
  collaborators   FlowCollaborator[]
  huddleSegments  HuddleSegment[]
  huddleNotes     HuddleNote[]
  webhookReceipts FlowWebhookReceipt[]

  @@index([organizationId, updatedAt])
  // Scheduler cursor scan, as on agent_tasks.
  @@index([status, id])
  // Same due-range read as agent_tasks. Matters more here: examining a flow also
  // costs a correlated lookup of its most recent run, so narrowing WHICH flows
  // are examined removes that subquery for every row that cannot be due.
  @@index([status, nextRunAt])
  // The activity dispatcher's match query — see activitySource's doc comment.
  @@index([organizationId, activitySource])
  @@map("flows")
}

/// A reusable, WIRED flow: a validated graph plus the notes that explain it.
/// Unlike an AgentTemplate (one prose blob the model reads at run time), the
/// executable artifact here IS the graph — `notes` is the human-facing
/// explanation anchored to it, and `bindings` says how to fill the graph's
/// empty agent/connection slots in whatever workspace instantiates it.
model FlowTemplate {
  id              String  @id @default(cuid())
  name            String
  description     String? @db.Text
  category        String  @default("Custom")
  graph           Json
  trigger         Json    @default("{}")
  /// FlowTemplateNotes — objective, per-step explanations, setup checklist.
  notes           Json?
  /// FlowTemplateBinding[] — how to resolve the graph's agent/connection slots.
  bindings        Json    @default("[]")
  /// integrations, tags, icon, exampleOutput, authorName
  configuration   Json?
  isActive        Boolean @default(true)
  /// 'user' (hand-authored / saved from a flow) or 'ai_generated'.
  source          String  @default("user")
  /// 'org' = this workspace only (default); 'global' = published to the shared
  /// community library, readable cross-org. Mirrors AgentTemplate.
  visibility      String  @default("org")
  /// 'none' = not in the catalogue; 'published' = approved through review;
  /// 'legacy_published' = was global before review existed, pending audit.
  catalogueStatus String  @default("none")
  /// Bumped on every content edit; prior payloads live in FlowTemplateVersion.
  version         Int     @default(1)

  userId         String
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FlowTemplateVersion[]

  @@index([organizationId, isActive])
  @@index([organizationId, visibility])
  @@map("flow_templates")
}

/// Immutable prior payload of a FlowTemplate, written before every content
/// edit or restore. `snapshot` holds {name, description, category, graph,
/// trigger, notes, bindings, configuration} — everything a restore reproduces.
model FlowTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  organizationId String   @db.Uuid
  version        Int
  snapshot       Json
  savedBy        String?
  createdAt      DateTime @default(now())

  template     FlowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([organizationId, templateId])
  @@map("flow_template_versions")
}

// Cross-workspace jam grants: a user outside the flow's org who accepted a
// share link. Durable — rotating the link revokes future opens, not rows.
model FlowCollaborator {
  id        String   @id @default(cuid())
  flowId    String
  userId    String
  role      String   @default("edit") // 'edit' | 'view'
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, userId])
  @@index([userId])
  @@map("flow_collaborators")
}

// Binary/original file uploads (run-form file inputs, future step outputs).
// Bytes live in Supabase Storage when configured (backend 'supabase',
// storagePath set) else inline in the row (backend 'db', data set).
model StoredFile {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String?
  filename       String
  mimeType       String   @default("application/octet-stream")
  size           Int
  backend        String   @default("db")
  storagePath    String?
  data           Bytes?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("stored_files")
}

/// A request to publish a flow, and its decision.
///
/// One OPEN row per flow at a time: a second request while one is pending is
/// the same question asked twice. Decided rows are kept — who approved a change
/// that later broke something is exactly the question an incident asks, and it
/// is unanswerable from the flow row alone.
model FlowReview {
  id             String    @id @default(cuid())
  flowId         String
  organizationId String    @db.Uuid
  /// Snapshot of the draft as submitted, so a reviewer approves what they read
  /// rather than whatever the author edited after asking.
  graph          Json
  /// What changed vs the published version, from the same summarizer the
  /// History panel uses.
  summary        Json?
  note           String?   @db.Text
  status         String    @default("open") // open | approved | rejected | withdrawn
  requestedBy    String
  requestedAt    DateTime  @default(now())
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?   @db.Text

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, requestedAt])
  @@index([flowId, status])
  @@map("flow_reviews")
}

model FlowVersion {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  version        Int
  graph          Json
  trigger        Json
  note           String?
  // What changed vs the previous published version — computed at publish time
  // ({ added/removed/changed: labels, moved, edgesAdded, edgesRemoved }) so the
  // History panel can say WHAT a version changed, not just when.
  summary        Json?
  publishedAt    DateTime @default(now())
  publishedBy    String?

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([organizationId, flowId])
  @@map("flow_versions")
}

/// The full draft graph AFTER each recorded edit (one row per History
/// "recent edit" entry), so any edit in the timeline can be viewed read-only
/// and restored — not just published versions. Rows are pruned to the newest
/// per flow on write; the matching audit event carries this row's id.
model FlowEditSnapshot {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  graph          Json
  // Same shape as FlowVersion.summary, vs the previous draft state.
  summary        Json?
  editedBy       String?
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, flowId, createdAt])
  @@map("flow_edit_snapshots")
}

/// Transient working state for huddle notes: one row per uploaded audio chunk,
/// already transcribed. The audio itself is never stored. Rows are deleted the
/// moment a session is summarised; the retention cron sweeps any orphaned by
/// someone closing their laptop mid-huddle.
model HuddleSegment {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  sessionId      String
  speakerName    String
  text           String   @db.Text
  startedAt      DateTime
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
  @@index([createdAt])
  @@map("huddle_segments")
}

/// What survives a captured huddle: the summary, not the verbatim record.
model HuddleNote {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  sessionId      String   @unique
  summary        String   @db.Text
  decisions      Json     @default("[]")
  participants   Json     @default("[]")
  startedAt      DateTime
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([flowId, createdAt])
  @@map("huddle_notes")
}

model FlowRun {
  id                String    @id @default(cuid())
  flowId            String
  status            String    @default("running") // running | succeeded | failed | waiting | cancelling | cancelled
  /// True only for a succeeded run with fine print: some step failed (on-error
  /// continue) or carried engine warnings. Computed once at finalize from the
  /// FULL step set — see execute-flow.ts — so the UI never re-infers this over
  /// a possibly-truncated summary payload.
  degraded          Boolean   @default(false)
  trigger           Json      @default("{}")
  input             Json      @default("{}")
  output            Json?
  error             String?
  /// Denormalized sum of this run's LlmCall rows, so list views never
  /// aggregate. Internal ops estimate — see src/lib/usage/pricing.ts.
  costUsd           Decimal   @default(0) @db.Decimal(12, 6)
  /// Per-run "pretend this step produced X" map, set when forking a run or
  /// patching a failed one. Distinct from graph.pinData, which lives on the
  /// SHARED flow draft — overriding here never mutates the flow other people
  /// are editing. Precedence: stateOverrides > pinData > replayed output.
  stateOverrides    Json?
  graphSnapshot     Json? // the graph definition this run executed against
  // Immutable dependency fingerprint captured before dispatch: graph hash,
  // agent revisions, tool schemas/connections, and model defaults. A worker
  // compares it before executing so a queued/resumed run cannot silently pick
  // up incompatible live configuration.
  executionManifest Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  /// The scheduled occurrence this run belongs to (see dueOccurrence). Null for
  /// interactive, signal, webhook, subflow, and poll runs — the unique index
  /// below therefore binds only scheduled dispatch, so two ticks racing on one
  /// occurrence produce ONE run and the loser gets P2002. Duplicate protection
  /// used to be a read-then-act check that could not stop a true race.
  scheduledFor      DateTime?
  // When a `wait` step pauses the run on a timer, the wall-clock time it should
  // resume. The cron scan wakes waiting runs whose resumeAt is due. Null for
  // runs waiting on a human reply / approval / open-ended webhook callback.
  resumeAt          DateTime?
  // One-time hash for a webhook-wait callback capability. The plaintext token
  // is derived server-side and appears only in {{run.resumeUrl}}.
  resumeTokenHash   String?
  organizationId    String    @db.Uuid
  userId            String?

  flow        Flow             @relation(fields: [flowId], references: [id], onDelete: Cascade)
  steps       FlowRunStep[]
  sideEffects FlowSideEffect[]

  @@unique([flowId, scheduledFor])
  @@index([flowId, startedAt])
  @@index([status, resumeAt])
  // Per-org in-flight count — flows and agents share one worker-slot budget.
  @@index([organizationId, status])
  // Workspace-wide execution log: newest runs for one tenant without a table scan.
  @@index([organizationId, startedAt])
  @@map("flow_runs")
}

/// Replay guard for public flow webhooks. Providers supply a delivery id and
/// timestamp; the unique key makes retries safe across every web instance.
model FlowWebhookReceipt {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  deliveryId     String
  payloadHash    String
  flowRunId      String?
  status         String   @default("processing") // processing | accepted | failed
  lastError      String?
  receivedAt     DateTime @default(now())
  expiresAt      DateTime

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, deliveryId])
  @@index([expiresAt])
  @@index([organizationId, receivedAt])
  @@map("flow_webhook_receipts")
}

/// Exactly-once claim for (ActivityEvent, Flow): the dispatcher creates this
/// row first (P2002 = already fired) and dispatches only on success — the
/// flow-side twin of AgentExecution.idempotencyKey in signals/router.ts.
model ActivityTriggerClaim {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  activityEventId String       @db.Uuid
  /// Plain text, NOT @db.Uuid: Flow.id is a cuid (see model Flow), not a
  /// uuid — same fix as ActivityEvent.ownerUserId (20260822093000). Shipped
  /// typed uuid in Task 1's migration; every real Flow.id failed to write
  /// here at all until this was caught wiring the first writer that
  /// populates a non-null value (Task 6, the dispatcher itself).
  flowId          String
  status          String       @default("claimed") // 'claimed'|'dispatched'|'throttled'|'failed'
  /// Same fix as flowId above: FlowRun.id is also a cuid, not a uuid.
  flowRunId       String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, activityEventId, flowId])
  @@index([organizationId, flowId, createdAt])
  /// Backs the 5-minute stale-claim proactive sweep
  /// (`countStaleActivityTriggerClaims` in queue-watch.ts), which counts
  /// `status: 'claimed', createdAt: { lt: cutoff }` cross-org — without this
  /// it seq-scans the whole table every tick. Deferred from Task 6, added
  /// here (Task 8's schema slot per the plan).
  @@index([status, createdAt])
  @@map("activity_trigger_claims")
}

/// Durable handoff for side effects that must survive a process crash after the
/// owning transaction commits. Workers claim rows with a compare-and-set status
/// transition; failures are retried with exponential backoff.
model OutboxEvent {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  topic          String
  aggregateId    String?
  dedupeKey      String?
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  deliveredAt    DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model FlowRunStep {
  id               String    @id @default(cuid())
  flowRunId        String
  nodeId           String
  agentExecutionId String?
  order            Int       @default(0)
  status           String    @default("queued") // queued | running | succeeded | failed | skipped | waiting | resumed | cancelled | stopped
  input            Json      @default("{}")
  output           Json?
  error            String?
  // console.log / print() output captured from code steps, for display only —
  // never consumed by downstream nodes. An array of strings.
  logs             Json?
  // Degraded-success notes from the engine (StepOutcome.warnings): items an
  // itemError policy dropped, empty results, in-band tool errors. An array of
  // plain-English strings; null when the step ran clean.
  warnings         Json?
  startedAt        DateTime?
  finishedAt       DateTime?

  run FlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId, order])
  @@map("flow_run_steps")
}

/// Ledger of completed flow side effects, so a replayed step returns what the
/// first attempt produced instead of firing the write a second time.
///
/// Idempotency HEADERS only ever reached HTTP steps (one call site), and most
/// Nango/MCP providers ignore an unrecognized `idempotency-key` anyway. This is
/// what makes tool writes on every plane — Slack, Gmail, Drive, any delivery
/// tool — actually replay-safe.
model FlowSideEffect {
  id             String   @id @default(cuid())
  /// The idempotency SCOPE. Normally the flow run id; for poll-triggered runs
  /// `${flowId}:${dedupeValue}`, so two runs for the same polled item share
  /// keys and the second replays instead of re-firing. See runScopeKey.
  scopeKey       String
  /// Node id, or `${nodeId}#${index}` inside a per-item/loop step — the same
  /// key the step-persistence layer uses, so a loop iteration gets its own row.
  iterationKey   String
  /// Pagination index for paged HTTP steps; 0 for everything else.
  page           Int      @default(0)
  organizationId String   @db.Uuid
  provider       String
  tool           String
  result         Json
  createdAt      DateTime @default(now())

  /// Nullable + SetNull: a poll-scoped row must OUTLIVE the run that wrote it,
  /// or deleting that run would silently drop the dedupe protection. Retention
  /// sweeps these on the ledger's own createdAt — see /api/cron/retention.
  flowRunId String?
  run       FlowRun? @relation(fields: [flowRunId], references: [id], onDelete: SetNull)

  @@unique([scopeKey, iterationKey, page])
  @@index([organizationId, createdAt])
  @@map("flow_side_effects")
}

/// A file uploaded as knowledge for an agent. We store the EXTRACTED TEXT (no
/// blob storage); the original binary is not retained. Chunks are embedded (when
/// embeddings are configured) and retrieved into the agent's context at run time.
model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  agentId        String? // the agent this knowledge belongs to (null = org-wide)
  userId         String?
  filename       String
  mimeType       String
  sizeBytes      Int      @default(0)
  charCount      Int      @default(0)
  status         String   @default("ready") // ready | failed
  error          String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, agentId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String  @id @default(cuid())
  documentId     String
  organizationId String  @db.Uuid
  agentId        String?
  ordinal        Int     @default(0)
  content        String  @db.Text
  embedding      Json? // number[] embedding, or null when embeddings are unconfigured

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "knowledge_chunks_embedding_vec_hnsw")
  @@map("knowledge_chunks")
}

/// A user-authored skill in the PUBLIC community library: readable by every
/// workspace, writable only by the creator's org. Attached to agents by id and
/// composed into the system prompt at run time alongside built-in skills.
model SharedSkill {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  category        String   @default("Community")
  instructions    String   @db.Text
  tags            Json     @default("[]")
  integrations    Json     @default("[]")
  authorName      String   @default("")
  /// 'org' = this workspace only; 'global' = published to the shared library.
  /// Before the review gate every skill was implicitly global; the migration
  /// backfills existing rows to 'global' + catalogueStatus 'legacy_published'.
  visibility      String   @default("org")
  /// 'none' | 'published' | 'legacy_published' — mirrors the template tables.
  catalogueStatus String   @default("none")
  organizationId  String   @db.Uuid
  userId          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Org deletion cascades community skills — an orphaned skill has no owner able to edit or retire it.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt])
  @@map("shared_skills")
}

// The AI proposal review queue (sub-project C). A proposal is NOT a live
// template — the auto-generation engine writes `status:'open'` suggestions
// that a human reviews, then accepts (promoting a template-kind proposal via
// createTemplate) or dismisses. Nothing here is published without an explicit
// accept. `userId` null = an org-wide proposal; set = proposed for that rep.
model TemplateProposal {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  title             String
  rationale         String   @db.Text
  // agent_template | flow_template | process_improvement
  kind              String
  configuration     Json
  // open | accepted | dismissed
  status            String   @default("open")
  sourceEvidence    Json
  // Stamped on accept for a template-kind proposal (the AgentTemplate created).
  createdTemplateId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Org deletion cascades pending proposals — a proposal outlives no org.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("template_proposals")
}

/// An author's request to publish an artifact to the shared catalogue.
/// `snapshot` is FROZEN at submit time: it is what a reviewer reads and what
/// gets published, so edits the author makes afterward cannot reach a
/// published entry without a fresh submission.
model CatalogueSubmission {
  id                String    @id @default(cuid())
  /// 'flow_template' | 'agent_template' | 'shared_skill'
  kind              String
  /// 'pending' | 'changes_requested' | 'approved' | 'rejected' | 'withdrawn'
  status            String    @default("pending")
  title             String
  summary           String    @db.Text
  snapshot          Json
  /// The author's own row this was snapshotted from. Informational — the
  /// snapshot is authoritative and the source may be edited or deleted.
  sourceId          String?
  /// The SUBMITTING org, which is what makes this row org-scoped.
  organizationId    String    @db.Uuid
  submittedByUserId String
  reviewerUserId    String?
  reviewNote        String?   @db.Text
  decidedAt         DateTime?
  /// The published row created on approve.
  publishedEntryId  String?
  /// Findings from the submit-time secret scan: [{path, reason, preview}].
  /// Advisory for the reviewer — approval is never blocked on them.
  warnings          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("catalogue_submissions")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  ADMIN
  USER
  OWNER
  VIEWER
}

/// Weekly adoption aggregate, one row per organization per ISO week.
///
/// Exists because /api/cron/retention prunes AgentExecution at RETENTION_DAYS
/// (default 90), which makes any longer-horizon behavioural question
/// unanswerable by live query. Stores COUNTS ONLY — no user ids, no payloads —
/// which is precisely why it may outlive the retention window that exists to
/// bound inputs and outputs.
model AdoptionWeek {
  id                      String   @id @default(cuid())
  organizationId          String   @db.Uuid
  /// ISO week Monday, UTC.
  weekStart               DateTime @db.Date
  agentsCreated           Int      @default(0)
  agentsDeleted           Int      @default(0)
  execTotal               Int      @default(0)
  execManual              Int      @default(0)
  /// Full trigger mix, e.g. {"manual":61,"schedule":40,"signal":9}. Stored
  /// whole so a new trigger type needs no migration.
  execByTrigger           Json     @default("{}")
  /// Distinct humans who ran an agent manually or sent an agent chat message.
  /// A COUNT — the ids are deliberately not retained.
  engagedUsers            Int      @default(0)
  approvalsApproved       Int      @default(0)
  approvalsRejected       Int      @default(0)
  /// pending + approving + failed + superseded.
  approvalsOther          Int      @default(0)
  /// Median decidedAt - createdAt over DECIDED requests only; null when none
  /// were decided.
  approvalLatencyMedianMs Int?
  computedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart])
  @@index([weekStart])
  @@map("adoption_weeks")
}

/// One row per agent per week in which it executed. Feeds the cohort survival
/// curve.
///
/// `agentTaskId` carries NO foreign key to AgentTask, deliberately. This
/// table's whole purpose is history that outlives its source row, and an
/// ON DELETE CASCADE would erase the record proving an agent was abandoned —
/// abandonment being the signal. `cohortWeek` is denormalized onto every row
/// so the survival query never joins back to AgentTask.
model AgentCohortWeek {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  agentTaskId    String
  /// ISO week of AgentTask.createdAt.
  cohortWeek     DateTime @db.Date
  /// ISO week in which this agent executed at least once.
  activeWeek     DateTime @db.Date

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentTaskId, activeWeek])
  @@index([organizationId, cohortWeek])
  @@index([cohortWeek, activeWeek])
  @@map("agent_cohort_weeks")
}

/// Which Backstory user a Slack user is.
///
/// Written when a person connects THEIR OWN Slack (a per-user NangoConnection),
/// from auth.test against their token — never from the bot token, which knows
/// only the app.
///
/// A dedicated model rather than NangoConnection.metadata because this is read
/// on every mention. findSlackWorkspaceByTeamId documents that its JSON-blob
/// table scan was acceptable precisely BECAUSE it is not a hot path; this one
/// is, and gets a real unique index.
model SlackIdentity {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  /// Slack's `U…` id, as it arrives on an event's `actorExternalId`.
  slackUserId    String
  userId         String
  verifiedAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cascade, NOT SetNull: an identity row with no user would let a mention
  /// resolve to nobody while still LOOKING linked. Deprovisioning a person must
  /// take their Slack link with them.
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slackUserId])
  @@index([userId])
  @@map("slack_identities")
}

/// The teammate a bare @mention reaches in a given channel.
model SlackChannelBinding {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  channelId      String
  agentTaskId    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cascade: a binding to a deleted agent would send every bare mention in the
  /// channel to a teammate that no longer exists.
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelId])
  @@index([agentTaskId])
  @@map("slack_channel_bindings")
}
