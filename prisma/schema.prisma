generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  // Workspace avatar shown in the org switcher — a small data URL (client
  // resizes to 128px before upload) so no external storage is required.
  logoUrl               String?
  plan                  Plan      @default(TRIAL)
  /// Platform tier. 'internal' = Backstory; 'partner' = People.ai; 'customer'
  /// = every paying workspace. Only a platform reviewer may change this — it
  /// is never settable from a customer-facing route.
  kind                  String    @default("customer")
  // People.ai tenant binding: one Studio workspace per People.ai team. Set on
  // first People.ai connection; every rep from that team lands in this org.
  peopleAiTeamId        String?   @unique
  /// HMAC signing secret for this org's People.ai webhook deliveries.
  /// Stored encrypted (src/lib/crypto/secrets.ts encryptSecret) — verification
  /// needs the plaintext, so this is NOT a hash. Null = org falls back to the
  /// global PEOPLE_AI_WEBHOOK_SECRET during migration.
  peopleAiWebhookSecret String?
  // Entitlement snapshot, derived from an active People.ai Sales AI
  // connection and revalidated on a TTL (see src/lib/entitlement.ts).
  entitlementTier       String?
  entitlementStatus     String    @default("unknown")
  entitlementCheckedAt  DateTime? @db.Timestamptz(6)
  trialStartDate        DateTime  @default(now()) @db.Timestamptz(6)
  trialEndDate          DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  /// Transactionally maintained quota counter for StoredFile bytes.
  storageBytes          BigInt    @default(0)
  /// Enterprise access policy. `optional` allows AAL1; `required` requires a
  /// verified second factor (AAL2) for every interactive session.
  mfaPolicy             String    @default("optional")
  /// When true, members whose email belongs to a verified workspace domain
  /// must authenticate through an enterprise SSO provider.
  ssoEnforced           Boolean   @default(false)

  users                User[]
  agents               AgentTask[]
  executions           AgentExecution[]
  templates            AgentTemplate[]
  flowTemplates        FlowTemplate[]
  integrations         Integration[]
  notifications        Notification[]
  mcpConnections       McpConnection[]
  nangoConnections     NangoConnection[]
  integrationSecrets   IntegrationSecret[]
  httpCredentials      HttpCredential[]
  peopleAiConnections  PeopleAiConnection[]
  signals              Signal[]
  signalSubscriptions  SignalSubscription[]
  auditEvents          AuditEvent[]
  approvalRequests     ApprovalRequest[]
  agentMemories        AgentMemory[]
  flowVersions         FlowVersion[]
  flowEditSnapshots    FlowEditSnapshot[]
  flowTemplateVersions FlowTemplateVersion[]
  flows                Flow[]
  storedFiles          StoredFile[]
  customSignals        CustomSignal[]
  pushSubscriptions    PushSubscription[]
  knowledgeDocuments   KnowledgeDocument[]
  sharedSkills         SharedSkill[]
  templateProposals    TemplateProposal[]
  invitations          Invitation[]
  catalogueSubmissions CatalogueSubmission[]
  huddleSegments       HuddleSegment[]
  huddleNotes          HuddleNote[]
  flowWebhookReceipts  FlowWebhookReceipt[]
  outboxEvents         OutboxEvent[]
  domains              OrganizationDomain[]
  allowedDomains       PlatformAllowedDomain[]
  scimTokens           ScimToken[]
  apiKeys              ApiKey[]

  @@map("organizations")
}

/// A pending invitation to join an organization. The plaintext token is emailed
/// (and shown once to the inviter); only its SHA-256 hash is stored. Accepting
/// moves the invited user into this org with `role`. Membership is a single-org
/// FK on User, so accepting reassigns the user's organizationId.
model Invitation {
  id               String    @id @default(cuid())
  email            String
  organizationId   String    @db.Uuid
  // 'ADMIN' | 'USER' — validated at the API layer (kept as text to avoid an
  // enum-typed column on a brand-new table).
  role             String    @default("USER")
  tokenHash        String    @unique
  // 'PENDING' | 'ACCEPTED' | 'REVOKED'
  status           String    @default("PENDING")
  invitedById      String?
  acceptedByUserId String?
  expiresAt        DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  acceptedAt       DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model User {
  id                   String    @id @default(cuid())
  supabaseId           String    @unique @db.Uuid
  email                String?
  name                 String?
  imageUrl             String?
  // People.ai membership id from the MCP OAuth context — the delegated
  // identity used for user-scoped People.ai tool calls.
  peopleAiMembershipId String?
  role                 UserRole  @default(USER)
  /// Platform tier, independent of the org role. null for everyone outside
  /// Backstory. 'staff' = internal employee; 'reviewer' = may decide and
  /// publish catalogue submissions.
  platformRole         String?
  organizationId       String?   @db.Uuid
  isActive             Boolean   @default(true)
  lastSeenAt           DateTime? @db.Timestamptz(6)
  timezone             String    @default("UTC")
  metadata             Json?
  /// Stable identity supplied by SCIM. Unique only inside a workspace.
  scimExternalId       String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions          AgentExecution[]
  templates           AgentTemplate[]
  flowTemplates       FlowTemplate[]
  integrations        Integration[]
  ownedAgents         AgentTask[]
  peopleAiConnections PeopleAiConnection[]
  mcpConnections      McpConnection[]
  apiKeys             ApiKey[]

  @@index([organizationId])
  @@unique([organizationId, scimExternalId])
  @@map("users")
}

/// A domain becomes authoritative only after its DNS TXT challenge verifies.
model OrganizationDomain {
  id                    String    @id @default(cuid())
  organizationId        String    @db.Uuid
  domain                String    @unique
  verificationTokenHash String
  verificationToken     String
  status                String    @default("pending") // pending | verified
  verifiedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("organization_domains")
}

/// One LLM or embedding API call. Detail rows for internal cost visibility;
/// denormalized totals live on AgentExecution/FlowRun so list views never
/// aggregate. Rows older than 90 days are swept by the retention cron — the
/// totals survive, so historical run cost stays visible after detail ages out.
///
/// Deliberately declares no relation fields: the three parent ids are nullable
/// and point at different models, so keeping them as plain columns avoids three
/// optional relations on hot models for a table only ever queried directly.
model LlmCall {
  id               String   @id @default(cuid())
  organizationId   String   @db.Uuid
  agentExecutionId String?
  flowRunId        String?
  flowRunStepId    String?
  /// agent_turn | structured | headline | embedding | eval_judge
  surface          String
  provider         String
  model            String
  inputTokens      Int      @default(0)
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  outputTokens     Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  /// Which price table produced costUsd. 'unknown' means the model had no rate.
  priceVersion     String
  createdAt        DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([flowRunId])
  @@map("llm_calls")
}

/// Platform-level access gate: which email domains may reach the product at
/// all. Deliberately SEPARATE from OrganizationDomain — that model answers
/// "does this domain belong to workspace X" for SSO enforcement, and
/// overloading it would let a customer verifying a domain silently grant
/// itself platform access.
///
/// COMPANY_EMAIL_DOMAINS (src/lib/auth/company-domain.ts) stays hardcoded and
/// is NOT represented here, so no table edit can lock staff out.
model PlatformAllowedDomain {
  id             String    @id @default(cuid())
  /// Bare hostname, lowercased. Exact match only — no wildcards.
  domain         String    @unique
  /// The shared workspace every user from this domain joins.
  organizationId String    @db.Uuid
  note           String    @default("")
  addedByUserId  String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  /// Set to disable without losing the audit trail. Null = active.
  disabledAt     DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("platform_allowed_domains")
}

/// A super-admin grant addressed to an EMAIL rather than an existing user, so
/// reviewers can be added before their first sign-in. Existing accounts are
/// promoted directly (users.platformRole); a row here is claimed — and stamped,
/// not deleted, to keep the audit trail — when an account with this email is
/// provisioned. Platform table: no tenant owns it, RLS denies the tenant role.
model PlatformStaffEmail {
  id              String    @id @default(cuid())
  /// Lowercased, exact match.
  email           String    @unique
  addedByUserId   String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  /// Stamped when a newly provisioned account consumed this grant.
  claimedAt       DateTime? @db.Timestamptz(6)
  claimedByUserId String?

  @@map("platform_staff_emails")
}

/// Bearer credentials accepted by the SCIM 2.0 provisioning surface. Only a
/// SHA-256 digest is stored; plaintext is shown once at mint time.
model ScimToken {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  name           String
  tokenHash      String    @unique
  prefix         String
  createdById    String
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@map("scim_tokens")
}

/// Customer API key. Scopes are a JSON string array so new public API
/// capabilities do not require an enum migration.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         Json      @default("[]")
  lastUsedAt     DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

model AgentTask {
  id             String    @id @default(cuid())
  type           String    @default("agent")
  priority       String    @default("MEDIUM")
  agentType      String    @default("CUSTOM")
  description    String    @db.Text
  objective      String    @db.Text
  goal           String?   @db.Text
  context        Json      @default("{}")
  schedule       Json      @default("{}")
  status         String    @default("ACTIVE")
  folder         String?
  visibility     String    @default("shared")
  organizationId String    @db.Uuid
  userId         String?
  metadata       Json?
  lastExecutedAt DateTime?
  executionCount Int       @default(0)
  lastResult     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  executions          AgentExecution[]
  signalSubscriptions SignalSubscription[]
  chatMessages        AgentChatMessage[]
  chatSessions        AgentChatSession[]
  connectors          AgentConnector[]
  memories            AgentMemory[]

  @@index([organizationId, status])
  @@index([userId])
  // The scheduler's cursor scan: `status = 'ACTIVE' ORDER BY id`, across all
  // orgs. The [organizationId, status] index above can't serve it — wrong
  // leading column — so without this the sweep is a full table scan every tick.
  @@index([status, id])
  @@map("agent_tasks")
}

/// Typed binding between an agent and a connector it uses. Replaces matching
/// fuzzy strings against the agent's `metadata.integrations` JSON with real
/// rows: a canonical connector key, its plane (kind), and — for a per-org MCP
/// connection — a foreign key with referential integrity (deleting the
/// connection nulls the binding instead of leaving a dangling string).
model AgentConnector {
  id              String   @id @default(cuid())
  agentTaskId     String
  organizationId  String   @db.Uuid
  /// Canonical selection key (registry key or connection name).
  connectorKey    String
  /// Plane: 'builtin' | 'nango' | 'backstory' | 'mcp' | 'external'.
  kind            String   @default("external")
  /// Optional FK to a specific per-org MCP connection this binding targets.
  mcpConnectionId String?
  config          Json     @default("{}")
  createdAt       DateTime @default(now())

  agentTask     AgentTask      @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  mcpConnection McpConnection? @relation(fields: [mcpConnectionId], references: [id], onDelete: SetNull)

  @@unique([agentTaskId, connectorKey])
  @@index([organizationId])
  @@index([mcpConnectionId])
  @@map("agent_connectors")
}

/// Durable, agent-scoped memory: answers to clarifying questions, learnings
/// distilled from executions, and proactive suggestions. Retrieved by kind +
/// status to ground future runs without re-asking or re-deriving.
model AgentMemory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  agentId        String
  kind           String // 'user_answer' | 'learning' | 'suggestion'
  title          String
  content        String  @db.Text
  question       String? @db.Text
  embedding      Json?

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  sourceExecutionId String?
  status            String    @default("open") // 'open' | 'dismissed' | 'superseded'
  timesUsed         Int       @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AgentTask    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, kind, status])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "agent_memories_embedding_vec_hnsw")
  @@map("agent_memories")
}

// Agent-scoped assistant chat (persistent per agent + user, not per execution).
// Additive: new table only. `metadata` carries assistant proposals and their
// applied-at marker, mirroring the JSON grab-bag pattern used elsewhere.
model AgentChatMessage {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Groups messages into a conversation. Nullable so pre-existing flat threads
  // (before sessions) read as one implicit "Earlier conversation".
  sessionId      String?
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  agentTask AgentTask         @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  session   AgentChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_chat_messages")
}

// A single assistant conversation for one agent + user. Multiple sessions per
// agent give users a "new chat" and a browsable history, scoped per agent.
model AgentChatSession {
  id             String   @id @default(cuid())
  agentTaskId    String
  organizationId String   @db.Uuid
  userId         String
  // Auto-derived from the first user message; null until the first message.
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentTask AgentTask          @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  messages  AgentChatMessage[]

  @@index([agentTaskId, userId, updatedAt])
  @@map("agent_chat_sessions")
}

// Inbound People.ai Sales AI event (webhook or poller). Immutable once
// written; the router turns matching signals into agent executions.
model Signal {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // One of the documented SalesAI events: deal.score_updated,
  // deal.risk_detected, deal.stage_changed, forecast.updated,
  // insight.generated, stakeholder.engagement_changed.
  type           String
  accountId      String?
  opportunityId  String?
  stakeholderId  String?
  payload        Json
  // Replay guard: provider event id (or a content hash fallback). Unique PER
  // ORG (see @@unique below), not globally — a raw provider event id from one
  // tenant must never dedupe-drop another tenant's signal.
  dedupeKey      String
  provenanceUrl  String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionRuns AgentExecution[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, receivedAt])
  @@index([organizationId, type])
  @@map("signals")
}

// Routing rule: signal type + JSON filter → run an agent, with the signal
// injected as structured context.
model SignalSubscription {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  signalType     String
  // Shallow equality filter over signal payload/entity fields, e.g.
  // {"risk_level": "high"}. Empty object matches everything.
  filter         Json     @default("{}")
  agentTaskId    String
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTask    AgentTask    @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId, signalType, isActive])
  @@map("signal_subscriptions")
}

// A rep-defined "custom signal": a saved SalesAI question (e.g. "who's talking
// about this account?", "what's the next best action?") reused here — People.ai
// exposes no signal catalog, so the definition lives on our side and runs via
// the ask_sales_ai_about_account/opportunity MCP tools. Per rep (owner), org
// scoped, matching the graph isolation posture.
model CustomSignal {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String
  name           String
  question       String   @db.Text
  // 'account' | 'opportunity' — which ask_sales_ai tool it runs against.
  scope          String   @default("account")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, updatedAt])
  @@map("custom_signals")
}

model AgentExecution {
  id              String    @id @default(cuid())
  agentType       String
  agentTemplateId String?
  agentTaskId     String?
  // Replay/duplicate guard for signal-triggered runs (signalId:agentId).
  idempotencyKey  String?
  signalId        String?
  status          String    @default("pending")
  input           Json
  output          Json?
  error           String?
  executionTime   Int?      @default(0)
  trigger         Json
  metadata        Json?
  model           String?
  transcript      Json?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  /// Denormalized sum of this execution's LlmCall rows, so list views never
  /// aggregate. Internal ops estimate — see src/lib/usage/pricing.ts.
  costUsd         Decimal   @default(0) @db.Decimal(12, 6)
  userId          String
  organizationId  String    @db.Uuid
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTemplate AgentTemplate?     @relation(fields: [agentTemplateId], references: [id], onDelete: SetNull)
  agentTask     AgentTask?         @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  signal        Signal?            @relation(fields: [signalId], references: [id], onDelete: SetNull)
  workflowSteps WorkflowStep[]
  events        WorkflowEvent[]
  messages      ExecutionMessage[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startedAt])
  @@index([agentTaskId])
  // Per-org in-flight count (src/lib/queue/org-capacity.ts), read once per
  // scheduler tick to stop one workspace occupying the whole worker pool.
  @@index([organizationId, status])
  @@map("agent_executions")
}

model ExecutionMessage {
  id          String   @id @default(cuid())
  executionId String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_messages")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String?
  type           String
  level          String    @default("info")
  title          String
  body           String?   @db.Text
  agentTaskId    String?
  executionId    String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   @db.Uuid
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  executionId String
  node        String
  status      String
  input       Json      @default("{}")
  output      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  execution AgentExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  events    WorkflowEvent[]

  @@index([executionId, createdAt])
  @@map("workflow_steps")
}

model WorkflowEvent {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  kind        String
  payload     Json?
  ts          DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step      WorkflowStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, ts])
  @@map("workflow_events")
}

// Append-only audit trail of consequential actions (tool writes, config
// changes, connections, approvals). Never updated or deleted in normal
// operation; exportable per org for enterprise compliance.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  actorUserId    String?
  actorKind      String   @default("user") // 'user' | 'agent' | 'system'
  action         String // e.g. 'tool.write', 'agent.config_changed'
  resourceType   String?
  resourceId     String?
  tool           String?
  executionId    String?
  // Hash (not contents) of the payload — proves what happened without storing
  // potentially sensitive tool arguments in the audit row.
  payloadHash    String?
  detail         Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("audit_events")
}

// A pending outbound-write approval. The run parks (waiting_for_input) until an
// approver decides; on approval the write proceeds, on rejection it is skipped.
model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  executionId    String
  tool           String
  summary        String    @db.Text
  payload        Json
  status         String    @default("pending") // 'pending' | 'approving' | 'approved' | 'rejected' | 'failed' | 'superseded'
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("approval_requests")
}

model AgentTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  type            String
  configuration   Json?
  isActive        Boolean  @default(true)
  schedule        String?
  priority        String   @default("MEDIUM")
  metadata        Json?
  // Where the template came from: 'user' (hand-authored) or 'ai_generated'
  // (proposed by the auto-generation engine, sub-project C).
  source          String   @default("user")
  // 'org' = visible only to the owning org (default); 'global' = published to
  // the shared community library, readable cross-org. Existing rows are
  // backfilled to 'global' by the migration to preserve prior behavior.
  visibility      String   @default("org")
  /// 'none' = not in the catalogue; 'published' = approved through review;
  /// 'legacy_published' = was global before review existed, pending audit.
  catalogueStatus String   @default("none")
  userId          String
  organizationId  String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]

  @@index([organizationId, isActive])
  @@index([organizationId, visibility])
  @@map("agent_templates")
}

model Integration {
  id             String    @id @default(cuid())
  userId         String
  organizationId String    @db.Uuid
  provider       String
  expiresAt      DateTime? @db.Timestamptz(6)
  scopes         String[]  @default([])
  status         String    @default("connected")
  failCount      Int       @default(0)
  lastError      String?   @db.Text
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Scoped per workspace, not globally per user: the same person may hold a
  // connection to the same provider in two workspaces over time, and the old
  // global key meant a stale row from a workspace they had LEFT permanently
  // occupied the slot, making the provider un-reconnectable. See
  // src/lib/org-transfer.ts.
  @@unique([organizationId, userId, provider])
  @@index([organizationId, provider])
  @@map("integrations")
}

// Per-user People.ai Sales AI connection: encrypted mcp_* tokens from the
// mcp.people.ai OAuth flow, plus the team/membership identity they resolve to.
// One connection per user per workspace; agents read People.ai as this user.
model PeopleAiConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  userId         String
  teamId         String?
  membershipId   String?
  scope          String?
  accessToken    String // encrypted (src/lib/crypto/secrets.ts)
  refreshToken   String? // encrypted
  status         String    @default("active") // 'active' | 'refresh_failed' | 'revoked'
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("people_ai_connections")
}

model McpConnection {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  // Personal connection when set (e.g. the per-user Backstory MCP row);
  // null = org-shared server added via the connections page.
  userId         String?
  // Platform-managed provider slug ('backstory'); null = user-added server.
  provider       String?
  name           String
  description    String?
  serverUrl      String
  authType       String    @default("none") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json      @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  healthStatus   String    @default("unknown") // unknown | healthy | unhealthy | schema_changed
  lastError      String?   @db.Text
  toolSchemaHash String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentBindings AgentConnector[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, isActive])
  @@map("mcp_connections")
}

// Mirror of a Nango connected account, scoped per-organization. Nango owns
// the credentials; we only persist connection ids and health for listing.
model NangoConnection {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  connectionId      String
  providerConfigKey String
  provider          String?
  status            String   @default("connected")
  lastError         String?  @db.Text
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connectionId])
  @@index([organizationId, providerConfigKey])
  @@map("nango_connections")
}

// Per-organization secret for built-in integrations (e.g. the Granola API
// key). authConfig holds the encrypted blob produced by buildAuthConfig().
model IntegrationSecret {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  provider       String
  authType       String   @default("api_key") // 'none' | 'api_key' | 'oauth2'
  authConfig     Json     @default("{}") // encrypted secret blob + non-secret fields
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, isActive])
  @@map("integration_secrets")
}

// Reusable encrypted credentials for generic HTTP Request nodes. A flow stores
// only this row's id; plaintext secrets never enter graph JSON or run logs.
// `allowedHost` binds a credential to the API host it was verified against so
// it cannot be silently replayed to an unrelated endpoint.
model HttpCredential {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  name           String
  authType       String
  allowedHost    String
  secretConfig   String    @db.Text
  status         String    @default("verified")
  lastVerifiedAt DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, authType, allowedHost])
  @@map("http_credentials")
}

/// A visual agent pipeline: a graph of steps, each running a workspace agent
/// via runAgentExecution. Distinct from WorkflowStep/WorkflowEvent (those are a
/// single agent's internal tool-call trace). See docs/superpowers/specs.
model Flow {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  status         String   @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  trigger        Json     @default("{}") // { type: 'manual'|'schedule'|'signal', ... }
  graph          Json     @default("{}") // working draft: { nodes, edges }
  publishedGraph Json? // the live version scheduled/triggered runs execute
  version        Int      @default(1) // bumped on each publish
  visibility     String   @default("shared")
  shareToken     String?  @unique // rotatable cross-workspace share-link token
  shareRole      String   @default("view") // role a share-link grants: 'view' | 'edit'
  /// May the share token be opened WITHOUT signing in? Anonymous opens land on
  /// a separate read-only page with a sanitized graph — never the builder, and
  /// never 'edit' regardless of shareRole.
  shareAnonymous Boolean  @default(false)
  /// Count of anonymous opens, surfaced to the owner so a public link is never
  /// silently accumulating traffic.
  anonymousViews Int      @default(0)
  folder         String   @default("") // workbook-style grouping ('' = ungrouped)
  // Polling-trigger dedupe state ({ seen: string[] }) — the keys of items already
  // emitted, so a poll only starts the flow for genuinely new records.
  pollCursor     Json?
  organizationId String   @db.Uuid
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs            FlowRun[]
  versions        FlowVersion[]
  editSnapshots   FlowEditSnapshot[]
  collaborators   FlowCollaborator[]
  huddleSegments  HuddleSegment[]
  huddleNotes     HuddleNote[]
  webhookReceipts FlowWebhookReceipt[]

  @@index([organizationId, updatedAt])
  // Scheduler cursor scan, as on agent_tasks.
  @@index([status, id])
  @@map("flows")
}

/// A reusable, WIRED flow: a validated graph plus the notes that explain it.
/// Unlike an AgentTemplate (one prose blob the model reads at run time), the
/// executable artifact here IS the graph — `notes` is the human-facing
/// explanation anchored to it, and `bindings` says how to fill the graph's
/// empty agent/connection slots in whatever workspace instantiates it.
model FlowTemplate {
  id              String  @id @default(cuid())
  name            String
  description     String? @db.Text
  category        String  @default("Custom")
  graph           Json
  trigger         Json    @default("{}")
  /// FlowTemplateNotes — objective, per-step explanations, setup checklist.
  notes           Json?
  /// FlowTemplateBinding[] — how to resolve the graph's agent/connection slots.
  bindings        Json    @default("[]")
  /// integrations, tags, icon, exampleOutput, authorName
  configuration   Json?
  isActive        Boolean @default(true)
  /// 'user' (hand-authored / saved from a flow) or 'ai_generated'.
  source          String  @default("user")
  /// 'org' = this workspace only (default); 'global' = published to the shared
  /// community library, readable cross-org. Mirrors AgentTemplate.
  visibility      String  @default("org")
  /// 'none' = not in the catalogue; 'published' = approved through review;
  /// 'legacy_published' = was global before review existed, pending audit.
  catalogueStatus String  @default("none")
  /// Bumped on every content edit; prior payloads live in FlowTemplateVersion.
  version         Int     @default(1)

  userId         String
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FlowTemplateVersion[]

  @@index([organizationId, isActive])
  @@index([organizationId, visibility])
  @@map("flow_templates")
}

/// Immutable prior payload of a FlowTemplate, written before every content
/// edit or restore. `snapshot` holds {name, description, category, graph,
/// trigger, notes, bindings, configuration} — everything a restore reproduces.
model FlowTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  organizationId String   @db.Uuid
  version        Int
  snapshot       Json
  savedBy        String?
  createdAt      DateTime @default(now())

  template     FlowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([organizationId, templateId])
  @@map("flow_template_versions")
}

// Cross-workspace jam grants: a user outside the flow's org who accepted a
// share link. Durable — rotating the link revokes future opens, not rows.
model FlowCollaborator {
  id        String   @id @default(cuid())
  flowId    String
  userId    String
  role      String   @default("edit") // 'edit' | 'view'
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, userId])
  @@index([userId])
  @@map("flow_collaborators")
}

// Binary/original file uploads (run-form file inputs, future step outputs).
// Bytes live in Supabase Storage when configured (backend 'supabase',
// storagePath set) else inline in the row (backend 'db', data set).
model StoredFile {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  userId         String?
  filename       String
  mimeType       String   @default("application/octet-stream")
  size           Int
  backend        String   @default("db")
  storagePath    String?
  data           Bytes?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("stored_files")
}

model FlowVersion {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  version        Int
  graph          Json
  trigger        Json
  note           String?
  // What changed vs the previous published version — computed at publish time
  // ({ added/removed/changed: labels, moved, edgesAdded, edgesRemoved }) so the
  // History panel can say WHAT a version changed, not just when.
  summary        Json?
  publishedAt    DateTime @default(now())
  publishedBy    String?

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@index([organizationId, flowId])
  @@map("flow_versions")
}

/// The full draft graph AFTER each recorded edit (one row per History
/// "recent edit" entry), so any edit in the timeline can be viewed read-only
/// and restored — not just published versions. Rows are pruned to the newest
/// per flow on write; the matching audit event carries this row's id.
model FlowEditSnapshot {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  graph          Json
  // Same shape as FlowVersion.summary, vs the previous draft state.
  summary        Json?
  editedBy       String?
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, flowId, createdAt])
  @@map("flow_edit_snapshots")
}

/// Transient working state for huddle notes: one row per uploaded audio chunk,
/// already transcribed. The audio itself is never stored. Rows are deleted the
/// moment a session is summarised; the retention cron sweeps any orphaned by
/// someone closing their laptop mid-huddle.
model HuddleSegment {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  sessionId      String
  speakerName    String
  text           String   @db.Text
  startedAt      DateTime
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
  @@index([createdAt])
  @@map("huddle_segments")
}

/// What survives a captured huddle: the summary, not the verbatim record.
model HuddleNote {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  sessionId      String   @unique
  summary        String   @db.Text
  decisions      Json     @default("[]")
  participants   Json     @default("[]")
  startedAt      DateTime
  createdAt      DateTime @default(now())

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([flowId, createdAt])
  @@map("huddle_notes")
}

model FlowRun {
  id                String    @id @default(cuid())
  flowId            String
  status            String    @default("running") // running | succeeded | failed | waiting
  trigger           Json      @default("{}")
  input             Json      @default("{}")
  output            Json?
  error             String?
  /// Denormalized sum of this run's LlmCall rows, so list views never
  /// aggregate. Internal ops estimate — see src/lib/usage/pricing.ts.
  costUsd           Decimal   @default(0) @db.Decimal(12, 6)
  /// Per-run "pretend this step produced X" map, set when forking a run or
  /// patching a failed one. Distinct from graph.pinData, which lives on the
  /// SHARED flow draft — overriding here never mutates the flow other people
  /// are editing. Precedence: stateOverrides > pinData > replayed output.
  stateOverrides    Json?
  graphSnapshot     Json? // the graph definition this run executed against
  // Immutable dependency fingerprint captured before dispatch: graph hash,
  // agent revisions, tool schemas/connections, and model defaults. A worker
  // compares it before executing so a queued/resumed run cannot silently pick
  // up incompatible live configuration.
  executionManifest Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  // When a `wait` step pauses the run on a timer, the wall-clock time it should
  // resume. The cron scan wakes waiting runs whose resumeAt is due. Null for
  // runs waiting on a human reply / approval / open-ended webhook callback.
  resumeAt          DateTime?
  organizationId    String    @db.Uuid
  userId            String?

  flow  Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  steps FlowRunStep[]

  @@index([flowId, startedAt])
  @@index([status, resumeAt])
  // Per-org in-flight count — flows and agents share one worker-slot budget.
  @@index([organizationId, status])
  @@map("flow_runs")
}

/// Replay guard for public flow webhooks. Providers supply a delivery id and
/// timestamp; the unique key makes retries safe across every web instance.
model FlowWebhookReceipt {
  id             String   @id @default(cuid())
  flowId         String
  organizationId String   @db.Uuid
  deliveryId     String
  payloadHash    String
  flowRunId      String?
  status         String   @default("processing") // processing | accepted | failed
  lastError      String?
  receivedAt     DateTime @default(now())
  expiresAt      DateTime

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flowId, deliveryId])
  @@index([expiresAt])
  @@index([organizationId, receivedAt])
  @@map("flow_webhook_receipts")
}

/// Durable handoff for side effects that must survive a process crash after the
/// owning transaction commits. Workers claim rows with a compare-and-set status
/// transition; failures are retried with exponential backoff.
model OutboxEvent {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  topic          String
  aggregateId    String?
  dedupeKey      String?
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  deliveredAt    DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model FlowRunStep {
  id               String    @id @default(cuid())
  flowRunId        String
  nodeId           String
  agentExecutionId String?
  order            Int       @default(0)
  status           String    @default("queued") // queued | running | succeeded | failed | skipped | waiting
  input            Json      @default("{}")
  output           Json?
  error            String?
  // console.log / print() output captured from code steps, for display only —
  // never consumed by downstream nodes. An array of strings.
  logs             Json?
  startedAt        DateTime?
  finishedAt       DateTime?

  run FlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId, order])
  @@map("flow_run_steps")
}

/// A file uploaded as knowledge for an agent. We store the EXTRACTED TEXT (no
/// blob storage); the original binary is not retained. Chunks are embedded (when
/// embeddings are configured) and retrieved into the agent's context at run time.
model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  agentId        String? // the agent this knowledge belongs to (null = org-wide)
  userId         String?
  filename       String
  mimeType       String
  sizeBytes      Int      @default(0)
  charCount      Int      @default(0)
  status         String   @default("ready") // ready | failed
  error          String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, agentId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String  @id @default(cuid())
  documentId     String
  organizationId String  @db.Uuid
  agentId        String?
  ordinal        Int     @default(0)
  content        String  @db.Text
  embedding      Json? // number[] embedding, or null when embeddings are unconfigured

  /// pgvector copy of `embedding` (WS-R5). Reads/writes go through raw SQL —
  /// Prisma cannot query Unsupported columns. The Json column is legacy,
  /// kept for deploy-window safety; drop it in a future migration.
  embeddingVec Unsupported("vector(1024)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId])
  // HNSW index created by hand-edited migration SQL (Prisma's schema DSL has
  // no `hnsw`/`vector_cosine_ops` vocabulary); declaring it here keeps
  // `prisma migrate diff` from proposing to drop it as drift.
  @@index([embeddingVec], map: "knowledge_chunks_embedding_vec_hnsw")
  @@map("knowledge_chunks")
}

/// A user-authored skill in the PUBLIC community library: readable by every
/// workspace, writable only by the creator's org. Attached to agents by id and
/// composed into the system prompt at run time alongside built-in skills.
model SharedSkill {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  category        String   @default("Community")
  instructions    String   @db.Text
  tags            Json     @default("[]")
  integrations    Json     @default("[]")
  authorName      String   @default("")
  /// 'org' = this workspace only; 'global' = published to the shared library.
  /// Before the review gate every skill was implicitly global; the migration
  /// backfills existing rows to 'global' + catalogueStatus 'legacy_published'.
  visibility      String   @default("org")
  /// 'none' | 'published' | 'legacy_published' — mirrors the template tables.
  catalogueStatus String   @default("none")
  organizationId  String   @db.Uuid
  userId          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Org deletion cascades community skills — an orphaned skill has no owner able to edit or retire it.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt])
  @@map("shared_skills")
}

// The AI proposal review queue (sub-project C). A proposal is NOT a live
// template — the auto-generation engine writes `status:'open'` suggestions
// that a human reviews, then accepts (promoting a template-kind proposal via
// createTemplate) or dismisses. Nothing here is published without an explicit
// accept. `userId` null = an org-wide proposal; set = proposed for that rep.
model TemplateProposal {
  id                String   @id @default(cuid())
  organizationId    String   @db.Uuid
  userId            String?
  title             String
  rationale         String   @db.Text
  // agent_template | flow_template | process_improvement
  kind              String
  configuration     Json
  // open | accepted | dismissed
  status            String   @default("open")
  sourceEvidence    Json
  // Stamped on accept for a template-kind proposal (the AgentTemplate created).
  createdTemplateId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Org deletion cascades pending proposals — a proposal outlives no org.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("template_proposals")
}

/// An author's request to publish an artifact to the shared catalogue.
/// `snapshot` is FROZEN at submit time: it is what a reviewer reads and what
/// gets published, so edits the author makes afterward cannot reach a
/// published entry without a fresh submission.
model CatalogueSubmission {
  id                String    @id @default(cuid())
  /// 'flow_template' | 'agent_template' | 'shared_skill'
  kind              String
  /// 'pending' | 'changes_requested' | 'approved' | 'rejected' | 'withdrawn'
  status            String    @default("pending")
  title             String
  summary           String    @db.Text
  snapshot          Json
  /// The author's own row this was snapshotted from. Informational — the
  /// snapshot is authoritative and the source may be edited or deleted.
  sourceId          String?
  /// The SUBMITTING org, which is what makes this row org-scoped.
  organizationId    String    @db.Uuid
  submittedByUserId String
  reviewerUserId    String?
  reviewNote        String?   @db.Text
  decidedAt         DateTime?
  /// The published row created on approve.
  publishedEntryId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("catalogue_submissions")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  ADMIN
  USER
  OWNER
  VIEWER
}
