# Web and authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Turnstile SITE key. Must be set together with CAPTCHA protection in
# the Supabase dashboard (Authentication -> Attack Protection), which holds the
# matching SECRET key. Supabase — not this app — verifies the token, because
# password auth goes browser->Supabase and never touches a Next.js route.
# See src/lib/auth/captcha.ts. Unset = no bot protection widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Ship the strict nonce-based CSP in report-only mode first: the browser reports
# what WOULD have been blocked and blocks nothing. Watch reports for a release
# cycle, then unset to enforce. See src/lib/security/csp.ts.
CSP_REPORT_ONLY=false
# Max request body for a mutating API route, in bytes (default 4000000). Sits
# under the flow autosave PUT, which serialises the whole graph.
API_MAX_BODY_BYTES=4000000
# Bearer token gating the DETAILED body of /api/health (src/app/api/health/route.ts)
# — queue topology, dead-letter counts, worker heartbeat freshness, secret
# encryption status. The status code (200/503) is always public; only this
# body is gated. Falls back to CRON_SECRET if unset, so a monitor that already
# carries it needs no extra config. With neither set, detail is open outside
# production.
HEALTH_DETAIL_TOKEN=
# Sentry DSN for server-side error tracking (src/lib/observability/sentry.ts).
# Unset = captureError() is a silent no-op; crashes and dead-letters are
# console-only. NEXT_PUBLIC_SENTRY_DSN (browser-side, also referenced by
# src/lib/security/csp.ts to allow the Sentry origin) is separate and optional.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# OpenTelemetry OTLP/HTTP traces. Set either the signal-specific endpoint
# (normally ending /v1/traces) or the base OTLP endpoint. The web and worker
# emit connected flow.run, flow.step and agent.run spans. Unset = no-op.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
OTEL_SERVICE_NAME=backstory-studio
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Disabled by default in a multi-tenant process: when enabled, AWS/GCP/Azure
# external-secret connections may use the deployment's default workload
# identity instead of tenant-specific encrypted bootstrap credentials.
EXTERNAL_SECRETS_ALLOW_WORKLOAD_IDENTITY=false
# Retired encryption keys, comma-separated. Set during a key rotation so old
# payloads stay readable; unset once `npm run secrets:rotate` reports 0 remaining.
# Where the encryption key comes from: env (default) | vault | aws-kms.
# `env` keeps the key in plaintext in this environment. The other two hold it in
# a secrets manager and hand it to the process at boot, so reading the platform
# environment no longer yields every credential in the database.
ENCRYPTION_KEY_PROVIDER=env
#
# provider=vault — HashiCorp Vault KV v2. The secret needs a `key` field, and
# optionally `previous` (comma-separated) so a rotation stages inside Vault.
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_ENCRYPTION_KEY_PATH=v1/secret/data/backstory/encryption-key
#
# provider=aws-kms — a base64 KMS-encrypted data key. Useless without KMS
# access, which is the point. Requires @aws-sdk/client-kms.
# ENCRYPTION_KEY_CIPHERTEXT=
# ENCRYPTION_KEY_PREVIOUS_CIPHERTEXT=
# ENCRYPTION_KMS_KEY_ID=
# AWS_REGION=us-east-1

ENCRYPTION_KEY_PREVIOUS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for SCIM identity provisioning and complete account deletion. Never
# expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Voice huddle TURN relay — resolved per join in src/lib/flows/ice-config.ts,
# best tier first: Cloudflare -> self-hosted coturn ephemeral -> static -> STUN-only.
# See docs/voice-relay-setup.md. Unset (all) = STUN-only; huddles fail behind
# strict/symmetric NATs.
# Cloudflare Realtime TURN key id + API token (Cloudflare dashboard -> Realtime
# -> TURN Server). Recommended: short-lived credentials minted per call.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Self-hosted coturn shared secret (use-auth-secret mode) — mints ephemeral
# per-call credentials server-side. Requires TURN_URL below.
TURN_SECRET=
# TURN relay URL(s), comma-separated. Paired with TURN_SECRET (ephemeral) or
# with TURN_USERNAME/TURN_CREDENTIAL below (static, for relays without
# use-auth-secret) — TURN_SECRET takes precedence when both are set.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Data and worker
# Serverless (Vercel): DATABASE_URL = Supabase Transaction pooler (port 6543) with
# ?pgbouncer=true&connection_limit=1. DIRECT_URL = Session pooler (5432) for migrations.
#
# The WORKER needs a DIFFERENT value — it is one long-lived process running four
# BullMQ workers at AGENT_WORKER_CONCURRENCY each, so connection_limit=1 makes
# ~20 concurrent jobs contend for a single connection (P2024 pool timeouts under
# load). Use connection_limit=20 there. See render.yaml.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# Privileged (owner) connection for migrations and enumerated cross-tenant
# system services (src/lib/prisma.ts: systemPrisma). Falls back to DATABASE_URL
# when unset, which is fine while DATABASE_RLS_ENABLED is off (both roles are
# then the same privileged one) — but the moment RLS is enabled, DATABASE_URL
# must become a distinct non-owner, non-BYPASSRLS role, and this var is
# REQUIRED: src/lib/prisma.ts refuses to boot if DATABASE_RLS_ENABLED is set
# and SYSTEM_DATABASE_URL is not, because otherwise every system path (cron
# sweeps, tenant resolution, auth bootstrap, deny-all platform tables) would
# silently run as the non-owner role its own policies reject.
SYSTEM_DATABASE_URL=postgresql://SYSTEM_USER:PASSWORD@HOST:5432/DB
# PostgreSQL row-level security (src/lib/authz/rls-rollout.ts). Enabling every
# table at once caused three outages; roll out in stages instead. Accepts:
#   false / unset  — off (app-layer tenant guard is the only boundary)
#   Model,Model2   — exactly these Prisma models (the staged path)
#   true           — every org-scoped model (correct end state, bad first step)
# Model names come from ORG_SCOPED_MODELS in src/lib/tenant-guard.ts; an unknown
# name fails at boot rather than silently protecting nothing. Setting this to
# anything but false/unset also requires SYSTEM_DATABASE_URL above, or the app
# refuses to boot (see that var's comment).
DATABASE_RLS_ENABLED=false
REDIS_URL=redis://localhost:6379
AGENT_WORKER_CONCURRENCY=3
WORKER_PORT=3002

# Scheduler + fairness dials (all optional; defaults shown).
# Runs STARTED per cron tick. Not a scan limit — every active agent/flow is
# examined every tick; these bound how many dispatch at once, stalest first.
AGENT_DISPATCH_PER_TICK=25
FLOW_DISPATCH_PER_TICK=50
# Max concurrent runs (agents + flows combined) one workspace may hold.
ORG_MAX_INFLIGHT_RUNS=10
# Per-user write budget per minute, applied to every mutating API route.
# Only a GLOBAL limit when UPSTASH_REDIS_REST_* or REDIS_URL is set — otherwise
# it is per serverless instance and the real ceiling multiplies by instance count.
WRITE_RATE_LIMIT_PER_MIN=240

# File ingestion (FILE_SCAN_URL is required in production and must return JSON
# {"clean":true} for accepted bytes). Quotas are enforced atomically per org.
FILE_SCAN_URL=
FILE_SCAN_REQUIRED=false
ORG_FILE_STORAGE_MAX_BYTES=500000000
FILE_RETENTION_DAYS=90
# Optional strict replay protection. Enable when every webhook caller can send
# x-trigger-delivery-id and x-trigger-timestamp; leave false for providers that
# cannot set custom headers (the trigger secret still authenticates the call).
FLOW_WEBHOOK_REQUIRE_REPLAY_PROTECTION=false
# Last-node webhook mode durably queues the run, then waits at most this long
# for a fast result before returning 202 + a trigger-secret-protected status URL.
# Clamped to 25 seconds by the server; default 10000.
FLOW_WEBHOOK_RESPONSE_WAIT_MS=10000

# Agent runtime — model provider
# Anthropic (Claude) is the provider. Set ANTHROPIC_API_KEY — agents, the
# activity headlines, run Q&A, the copilot, and the "describe an agent" builder
# all run on Claude. Boot fails in production without a provider key.
ANTHROPIC_API_KEY=
# Optional model overrides — Claude model ids (claude-*). Defaults are set in
# src/lib/llm/model-runner.ts; leave unset to use them.
AGENT_MODEL=
SUMMARY_MODEL=
# Alternative provider: Qwen via DashScope's Anthropic-compatible endpoint.
# Set BOTH to use it instead of Claude (leave ANTHROPIC_API_KEY blank). Setting
# both ALONGSIDE ANTHROPIC_API_KEY is the normal deployment: Claude is primary,
# Qwen is the cross-endpoint fallback, and it is where runs go once a standard
# user has spent their daily Claude allowance (src/lib/usage/model-tiers.ts).
QWEN_API_KEY=
QWEN_BASE_URL=
# Optional: the exact model id the endpoint expects (e.g. qwen3-max), when it
# differs from the id shown in the UI.
QWEN_MODEL=
# Optional: USD per MILLION tokens, for the operator console's cost column.
# Unset by design — Qwen has no single list price to hardcode (it depends on
# which endpoint QWEN_BASE_URL points at and on your contract), so its calls
# show as unpriced until you fill these in.
QWEN_PRICE_INPUT_PER_MTOK=
QWEN_PRICE_OUTPUT_PER_MTOK=
# Model quality measurement (Admin -> Models -> Quality). All optional.
# Bench: candidates for `npm run eval:bench` (comma-separated model ids) and the
# one judge that grades every candidate (defaults to claude-sonnet-5 when
# Anthropic is configured).
BENCH_MODELS=
BENCH_JUDGE_MODEL=
# Shadow: run a sampled fraction of flow AI steps (side-effect-free by
# construction) through a challenger model and judge the pairs blind. Off until
# BOTH are set; rate is 0..1 (e.g. 0.05 = 5% of steps). Scores are stored,
# never text. Challenger spend appears in the ledger but does not count against
# the workspace's monthly token ceiling.
SHADOW_EVAL_MODEL=
SHADOW_EVAL_RATE=
AGENT_MAX_TURNS=16
# Optional: cap total (input+output) tokens per org per UTC month. 0/unset = unlimited.
AGENT_MONTHLY_TOKEN_LIMIT=0

# People.ai Sales AI (identity + entitlement gate + read tools)
# OAuth app credentials identifying Backstory Studio as an MCP client of
# mcp.people.ai — per-user connections happen through the browser flow.
PEOPLE_AI_OAUTH_CLIENT_ID=
PEOPLE_AI_OAUTH_CLIENT_SECRET=
# Optional: scope assigned by People.ai; MCP base URL override for testing.
PEOPLE_AI_OAUTH_SCOPE=
PEOPLE_AI_MCP_BASE_URL=
# Org-level Sales AI service credential (PAI-Client-Id / PAI-Client-Secret,
# self-served in the People.ai API settings). Setting BOTH turns on "native
# Sales AI mode": every workspace is assumed entitled and Sales AI works out of
# the box with no per-user OAuth (per-user connections stay an optional upgrade
# for rep-scoped reads/actions). Also used for non-interactive signal runs.
PEOPLE_AI_SERVICE_CLIENT_ID=
PEOPLE_AI_SERVICE_CLIENT_SECRET=
# SalesAI signal webhooks: shared secret for verifying inbound webhook
# signatures (from POST /v1/salesai/webhooks registration), and optional API
# base override. The receiver is disabled until the secret is set.
PEOPLE_AI_WEBHOOK_SECRET=
PEOPLE_AI_SALESAI_BASE_URL=
# Entitlement gate: defaults on in production, off in development.
# Force with 'on'/'off'. Keep 'off' in prod until the OAuth flow is verified.
ENTITLEMENT_GATE=
# Password signup: set 'false' to force SSO/invite-only (production).
AUTH_ALLOW_PASSWORD=
# Email domains admitted at sign-in, comma-separated (e.g. acme.com,globex.io).
# Additive to the hardcoded staff domains and the PlatformAllowedDomain table.
# REQUIRED on a customer-edition deploy: /admin/domains is gated off there, so
# this is the only way to admit anyone but hardcoded staff. Public email
# providers (gmail.com etc.) are refused even if listed.
ALLOWED_EMAIL_DOMAINS=

# Graph-RAG brain (correlates Sales AI signals + integration/MCP data + prior
# runs to give agents and the assistant richer context). All optional and
# gated: with none set, RAG is a clean no-op and nothing changes.
# Embeddings — Voyage AI (dashboard.voyageai.com → API Keys, pa-...).
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=
# Graph store — Neo4j (AuraDB or self-hosted). All three required for a durable
# graph; without them the store falls back to per-process in-memory.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Nango connected accounts (Connect UI + backend SDK). Nango is the single
# integration provider (OAuth storage + tool proxy) — it replaced Klavis.
# Setup + the exact dashboard integration ids to enable: docs/nango-setup.md
# Environment secret key from the Nango dashboard (Environment settings). Also
# verifies the /api/nango/webhook signature — no separate webhook secret.
# Nango API key — authorizes API calls. Nango SPLIT its old single secret: newer
# environments are issued a scoped API key plus a separate webhook signing key,
# and have no "secret key" at all. A scoped key needs at least
# environment:integrations:list and environment:connections:list.
NANGO_API_KEY=
# Verifies Nango webhook HMACs. Nango never signs with the API key, so without
# this every connection event fails verification and is dropped.
NANGO_WEBHOOK_SIGNING_KEY=
# Legacy single secret that did BOTH jobs. Still honoured as a fallback for
# either of the two above; leave blank if you set them.
NANGO_SECRET_KEY=
# Optional — self-hosted or regional Nango API host. Leave blank for Nango Cloud.
NANGO_HOST=
# Optional — self-hosted Connect UI base URL. Leave blank for https://connect.nango.dev.
NEXT_PUBLIC_NANGO_CONNECT_URL=
# Optional — per-request Nango proxy ceiling (ms) for delivery/tool calls. Default 20000.
NANGO_PROXY_TIMEOUT_MS=

# Secrets at rest — encrypts MCP connection and integration API keys
# (any non-empty string works; without it secrets fall back to plain base64).
ENCRYPTION_KEY=

# Granola meeting notes — optional global fallback API key (grn_...).
# Each workspace can save its own key on the integrations page, which takes
# precedence over this value.
GRANOLA_API_KEY=

# Web research (Brave Search API) — lets agents search the open web and read
# public pages. Optional; without it the research plane reports itself
# unavailable rather than failing a run silently. Each workspace can save its
# own key on the integrations page, which takes precedence over this value.
BRAVE_SEARCH_API_KEY=

# Web push (browser notifications) — optional; in-app notifications work without it.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Slack -------------------------------------------------------------------
# Backstory's own Slack app (Basic Information -> App Credentials).
# Platform-embedded and shared across every install: workspaces click
# "Add to Slack" and their per-workspace bot token is minted by Slack and
# stored automatically, so no one handles a token by hand.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies inbound Events API deliveries. Shared across installs by design —
# it is a signature verifier, not an identity. A BYO workspace's own secret
# takes precedence over this one.
SLACK_SIGNING_SECRET=
# Deliberately UNSET. A shared bot token is a shared identity; per-install
# tokens make it unnecessary, and only internal/partner orgs could use it.
# SLACK_BOT_TOKEN=
