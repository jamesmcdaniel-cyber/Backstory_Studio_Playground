{
  "name": "backstory-studio",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "build": "EXECUTION_MODE=queue prisma generate && node scripts/vercel-migrate.mjs && EXECUTION_MODE=queue next build && npm run smoke:wasm",
    "start": "next start",
    "worker:dev": "tsx watch src/lib/workers/runtime.ts",
    "worker:start": "tsx src/lib/workers/runtime.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test $(find src packages -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -path '*__tests__*')",
    "eval": "tsx --test $(find src/lib/eval -type f -name '*.test.ts' -path '*__tests__*')",
    "eval:rag": "tsx src/lib/eval/rag/run.ts",
    "eval:nightly": "tsx src/lib/eval/nightly.ts",
    "eval:bench": "tsx src/lib/eval/bench.ts",
    "eval:capture": "tsx src/lib/eval/capture.ts",
    "eval:rag:generate": "tsx src/lib/eval/rag/generate.ts",
    "load:flow": "k6 run scripts/load/flow-webhook.js",
    "load:platform": "k6 run scripts/load/platform.js",
    "load:shell": "k6 run scripts/load/shell-poll.js",
    "load:shell:100": "LOAD_STAGE=100 k6 run scripts/load/shell-poll.js",
    "load:shell:400": "LOAD_STAGE=400 k6 run scripts/load/shell-poll.js",
    "load:shell:1000": "LOAD_STAGE=1000 k6 run scripts/load/shell-poll.js",
    "secrets:rotate": "tsx scripts/rotate-encryption-key.ts",
    "embeddings:backfill": "tsx scripts/reembed-backfill.ts",
    "queue:dlq": "tsx scripts/queue-dlq.ts",
    "nango:doctor": "tsx scripts/nango-doctor.ts",
    "worker:smoke": "bash scripts/worker-smoke.sh",
    "backup:create": "node scripts/backup/create.mjs",
    "backup:restore": "node scripts/backup/restore.mjs",
    "backup:verify": "node scripts/backup/verify.mjs",
    "test:e2e": "playwright test",
    "test:e2e:anon": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:auth": "playwright test --project=authenticated --project=\"authenticated (limits)\"",
    "smoke:wasm": "node scripts/smoke-wasm-production.mjs",
    "sdk:build": "tsc -p packages/backstory-sdk/tsconfig.build.json",
    "sdk:test": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test packages/backstory-sdk/src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-secrets-manager": "^3.1119.0",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@google-cloud/secret-manager": "^7.0.0",
    "@nangohq/frontend": "^0.70.9",
    "@nangohq/node": "^0.70.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@types/web-push": "^3.6.4",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "bullmq": "^5.58.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "fastify": "^5.5.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.513.0",
    "motion": "^12.42.2",
    "neo4j-driver": "^6.2.0",
    "next": "^15.5.19",
    "openai": "^5.20.1",
    "pyodide": "^314.0.3",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "three": "^0.169.0",
    "tsx": "^4.20.5",
    "unpdf": "^1.6.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
